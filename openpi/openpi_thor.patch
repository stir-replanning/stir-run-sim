@@ -0,0 +1,155 @@
+import argparse
+import csv
+import os
+import sys
+
+import numpy as np
+from scipy.stats import gaussian_kde
+
+DATA = os.path.expanduser("~/kinova_dataset/data/simple.hdf5")
+LIFT = 0.03
+
+
+def build_state(obs):
+    return np.concatenate([
+        np.asarray(obs["robot0_eef_pos"], np.float32),
+        np.asarray(obs["robot0_eef_quat"], np.float32),
+        np.asarray(obs["robot0_gripper_qpos"], np.float32).reshape(-1)[:1],
+    ]).astype(np.float32)
+
+
+def elem(obs, prompt):
+    return {"observation/image": np.asarray(obs["agentview_image"], np.uint8),
+            "observation/wrist_image": np.asarray(obs["robot0_eye_in_hand_image"], np.uint8),
+            "observation/state": build_state(obs), "prompt": prompt}
+
+
+def kde_entropy(x):
+    try:
+        return float(-np.mean(np.log(gaussian_kde(x.T)(x.T) + 1e-12)))
+    except Exception:
+        return float("nan")
+
+
+def mmd_rbf(a, b):
+    g = 1.0 / (2.0 * (np.median(np.linalg.norm(a[:, None] - b[None], axis=-1)) ** 2) + 1e-9)
+    k = lambda x, y: np.exp(-g * ((x[:, None] - y[None]) ** 2).sum(-1))
+    return float(k(a, a).mean() + k(b, b).mean() - 2 * k(a, b).mean())
+
+
+def sliced_w2(a, b, n=64):
+    rng = np.random.default_rng(0)
+    th = rng.normal(size=(n, 2)); th /= np.linalg.norm(th, axis=1, keepdims=True)
+    pa, pb = np.sort(a @ th.T, 0), np.sort(b @ th.T, 0)
+    m = min(len(a), len(b))
+    return float(np.sqrt(((pa[:m] - pb[:m]) ** 2).mean()))
+
+
+def measures(red, yel, d_red, d_yel):
+    mr, my = red.mean(0), yel.mean(0)
+    return dict(
+        position=float(np.linalg.norm(mr - my)),
+        cmi=float(kde_entropy(np.vstack([red, yel])) - 0.5 * (kde_entropy(red) + kde_entropy(yel))),
+        mmd=mmd_rbf(red, yel), w2=sliced_w2(red, yel),
+        dir_red=float(mr @ d_red / (np.linalg.norm(mr) + 1e-9)),
+        dir_yellow=float(my @ d_yel / (np.linalg.norm(my) + 1e-9)))
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--host", default="0.0.0.0"); ap.add_argument("--port", type=int, default=8000)
+    ap.add_argument("--env-dir", default=os.path.expanduser("~/kinova_dataset/simple_env"))
+    ap.add_argument("--demos", required=True)
+    ap.add_argument("--offsets", default="-20,-14,-8,-2")
+    ap.add_argument("--n", type=int, default=200)
+    ap.add_argument("--exec-horizon", type=int, default=5)
+    ap.add_argument("--max-steps", type=int, default=260)
+    ap.add_argument("--out", required=True)
+    args = ap.parse_args()
+
+    import h5py
+    sys.path.insert(0, args.env_dir)
+    import kinova_simple_env as kse
+    from openpi_client import websocket_client_policy
+    policy = websocket_client_policy.WebsocketClientPolicy(args.host, args.port)
+
+    f = h5py.File(DATA, "r")["data"]
+    def grasp_of(demo):
+        g = np.asarray(f[demo]["obs"]["gripper_states"])[:, 0]
+        thr = g.min() + 0.2 * (g.max() - g.min()); cl = g > thr
+        return next((i for i in range(len(cl) - 5) if cl[i:i + 5].all()), int(np.argmax(cl)))
+
+    def lang(demo):
+        la = f[demo].attrs["language"]; return la.decode() if isinstance(la, bytes) else str(la)
+    langs = {}
+    for k in f.keys():
+        la = lang(k); c = "red" if "red" in la.lower() else "yellow"
+        langs.setdefault(c, la)
+
+    env = kse.make_simple_env(128, obj_center=(0.0, 0.1))
+    offs = [int(o) for o in args.offsets.split(",")]
+    demos = args.demos.split(",")
+    fields = ["demo", "S", "roll_grasp", "tau", "outcome", "label",
+              "position", "cmi", "mmd", "w2", "dir_red", "dir_yellow"]
+    fout = open(args.out, "w", newline=""); w = csv.DictWriter(fout, fieldnames=fields); w.writeheader()
+
+    for demo in demos:
+        d = f[demo]
+        la = lang(demo)
+        old_c = "red" if "red" in la.lower() else "yellow"
+        new_c = "yellow" if old_c == "red" else "red"
+        old_idx = int(d.attrs["obj_left_idx"]) if False else (0 if old_c == "red" else 1)
+        old_idx = 0 if old_c == "red" else 1
