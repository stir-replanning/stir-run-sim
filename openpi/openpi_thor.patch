index 272375e..eabe50b 100644
--- a/src/openpi/transforms.py
+++ b/src/openpi/transforms.py
@@ -324,6 +324,35 @@ class PromptFromLeRobotTask(DataTransformFn):
         return {**data, "prompt": prompt}
 
 
+@dataclasses.dataclass(frozen=True)
+class AttachDimgTarget(DataTransformFn):
+    targets_path: str
+    radius: float = 0.05
+    index_key: str = "index"
+
+    def __post_init__(self):
+        z = np.load(self.targets_path, allow_pickle=True)
+        idx = z["index"].astype(np.int64)
+        valid = z["valid_base"].astype(bool) & (z["nn_dist"].astype(np.float32) <= self.radius)
+        size = int(idx.max()) + 1
+        d_by_index = np.zeros(size, np.float32)
+        mask_by_index = np.zeros(size, bool)
+        d_by_index[idx] = np.nan_to_num(z["D"].astype(np.float32), nan=0.0)
+        mask_by_index[idx] = valid
+        object.__setattr__(self, "_d_by_index", d_by_index)
+        object.__setattr__(self, "_mask_by_index", mask_by_index)
+
+    def __call__(self, data: DataDict) -> DataDict:
+        if self.index_key not in data:
+            raise ValueError(f'AttachDimgTarget needs "{self.index_key}" in the raw sample')
+        i = int(np.asarray(data[self.index_key]).reshape(-1)[0])
+        return {
+            **data,
+            "dimg_target": np.float32(self._d_by_index[i]),
+            "dimg_target_mask": np.bool_(self._mask_by_index[i]),
+        }
+
+
 @dataclasses.dataclass(frozen=True)
 class PadStatesAndActions(DataTransformFn):
     """Zero-pads states and actions to the model action dimension."""
