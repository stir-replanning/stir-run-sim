index 0000000..2dccc04
--- /dev/null
+++ b/examples/kinova/cmi_repr_probe.py
@@ -0,0 +1,152 @@
+import argparse
+import csv
+import os
+import sys
+
+import numpy as np
+from scipy.stats import gaussian_kde
+
+DATA = os.path.expanduser("~/kinova_dataset/data/simple.hdf5")
+
+REPRS = {"xy": [0, 1], "z": [2], "xyz": [0, 1, 2], "grip": [6], "xyzg": [0, 1, 2, 6],
+         "full": [0, 1, 2, 3, 4, 5, 6]}
+
+
+def build_state(obs):
+    return np.concatenate([
+        np.asarray(obs["robot0_eef_pos"], np.float32),
+        np.asarray(obs["robot0_eef_quat"], np.float32),
+        np.asarray(obs["robot0_gripper_qpos"], np.float32).reshape(-1)[:1],
+    ]).astype(np.float32)
+
+
+def elem(obs, prompt):
+    return {"observation/image": np.asarray(obs["agentview_image"], np.uint8),
+            "observation/wrist_image": np.asarray(obs["robot0_eye_in_hand_image"], np.uint8),
+            "observation/state": build_state(obs), "prompt": prompt}
+
+
+def kde_entropy(x):
+    x = np.atleast_2d(np.asarray(x, float))
+    if x.shape[0] <= x.shape[1] + 1:
+        return float("nan")
+    x = x + 1e-9 * np.random.randn(*x.shape)
+    try:
+        return float(-np.mean(np.log(gaussian_kde(x.T)(x.T) + 1e-12)))
+    except Exception:
+        return float("nan")
+
+
+def cmi(a, b):
+    return float(kde_entropy(np.vstack([a, b])) - 0.5 * (kde_entropy(a) + kde_entropy(b)))
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--host", default="0.0.0.0")
+    ap.add_argument("--port", type=int, default=8000)
+    ap.add_argument("--env-dir", default=os.path.expanduser("~/kinova_dataset/simple_env"))
+    ap.add_argument("--demos", required=True)
+    ap.add_argument("--offsets", default="-2,-5,-10,-20,-35", help="grasp-relative switch steps (pre-grasp)")
+    ap.add_argument("--n", type=int, default=200)
+    ap.add_argument("--exec-horizon", type=int, default=5)
+    ap.add_argument("--max-steps", type=int, default=260)
+    ap.add_argument("--out", required=True)
+    args = ap.parse_args()
+
+    import h5py
+    sys.path.insert(0, args.env_dir)
+    import kinova_simple_env as kse
+    from openpi_client import websocket_client_policy
+    policy = websocket_client_policy.WebsocketClientPolicy(args.host, args.port)
+
+    f = h5py.File(DATA, "r")["data"]
+
+    def grasp_of(demo):
+        g = np.asarray(f[demo]["obs"]["gripper_states"])[:, 0]
+        thr = g.min() + 0.2 * (g.max() - g.min()); cl = g > thr
+        return next((i for i in range(len(cl) - 5) if cl[i:i + 5].all()), int(np.argmax(cl)))
+
+    def lang(demo):
+        la = f[demo].attrs["language"]
+        return la.decode() if isinstance(la, bytes) else str(la)
+    langs = {}
+    for k in f:
+        la = lang(k)
+        langs.setdefault("red" if "red" in la.lower() else "yellow", la)
+
+    env = kse.make_simple_env(128, obj_center=(0.0, 0.1))
+    offs = [int(o) for o in args.offsets.split(",")]
+    fields = (["demo", "S", "tau", "roll_grasp", "outcome", "label"]
+              + [f"cmi_{k}" for k in REPRS]
+              + ["ee_x", "ee_y", "ee_z", "d_old", "d_new", "z_above_old", "gripper"])
+    fout = open(args.out, "w", newline=""); w = csv.DictWriter(fout, fieldnames=fields); w.writeheader()
+
+    for demo in args.demos.split(","):
+        d = f[demo]
+        la = lang(demo)
+        old_i = 0 if "red" in la.lower() else 1
+        new_i = 1 - old_i
+        old_c = "red" if old_i == 0 else "yellow"
+        new_c = "yellow" if old_i == 0 else "red"
+        gt = grasp_of(demo)
+        st0 = np.asarray(d["states"][0], np.float64)
+
+        for off in offs:
+            S = max(1, gt + off)
+            try:
+                env.reset(); env.sim.set_state_from_flattened(st0); env.sim.forward()
+                env._spec["target_idx"] = new_i
+                obs = env._get_observations(force_update=True)
+                start_old = np.array(env.sim.data.body_xpos[env.obj_body_ids[old_i]])
+                roll_grasp = -1; steps = 0; meas = None
+                followed = stuck = False
+                while steps < args.max_steps and not followed and not stuck:
+                    if steps >= S and meas is None:
+                        old = np.array([np.asarray(policy.infer(elem(obs, langs[old_c]))["actions"])
+                                        for _ in range(args.n)])
+                        new = np.array([np.asarray(policy.infer(elem(obs, langs[new_c]))["actions"])
+                                        for _ in range(args.n)])
+                        meas = {f"cmi_{k}": cmi(old[:, :, cols].sum(1), new[:, :, cols].sum(1))
+                                for k, cols in REPRS.items()}
+                        ee = np.asarray(obs["robot0_eef_pos"], float)
+                        po = np.array(env.sim.data.body_xpos[env.obj_body_ids[old_i]])
+                        pn = np.array(env.sim.data.body_xpos[env.obj_body_ids[new_i]])
+                        meas.update(ee_x=round(float(ee[0]), 4), ee_y=round(float(ee[1]), 4),
+                                    ee_z=round(float(ee[2]), 4),
+                                    d_old=round(float(np.linalg.norm(ee[:2] - po[:2])), 4),
+                                    d_new=round(float(np.linalg.norm(ee[:2] - pn[:2])), 4),
+                                    z_above_old=round(float(ee[2] - po[2]), 4),
+                                    gripper=round(float(np.asarray(obs["robot0_gripper_qpos"])[0]), 4))
+                    prompt = langs[new_c] if steps >= S else langs[old_c]
+                    chunk = np.asarray(policy.infer(elem(obs, prompt))["actions"], np.float64)
+                    for action in chunk[: args.exec_horizon]:
+                        obs, _, _, _ = env.step(action)
+                        steps += 1
+                        po = np.array(env.sim.data.body_xpos[env.obj_body_ids[old_i]])
+                        if roll_grasp < 0 and float(po[2] - start_old[2]) > 0.03:
+                            roll_grasp = steps
+                        if steps >= S and env._check_success():
+                            followed = True; break
+                        gx, gy = env.guideline_xy; half = env.guideline_size / 2.0
+                        rest_z = float(env.table_offset[2]) + 0.002 + env._success_rest_z
+                        if abs(po[0] - gx) <= half and abs(po[1] - gy) <= half and po[2] < rest_z:
+                            stuck = True; break
+                    if steps > S + 220:
+                        break
+                outcome = "follow" if followed else ("stuck" if stuck else "neither")
+                row = dict(demo=demo, S=S, tau=off, roll_grasp=roll_grasp, outcome=outcome,
+                           label={"follow": "O", "stuck": "X", "neither": "∅"}[outcome],
+                           **(meas or {}))
+                w.writerow(row); fout.flush()
+                print(f"{demo} tau={off:4d} -> {outcome:7s} "
+                      + " ".join(f"{k}={meas[f'cmi_{k}']:+.2f}" for k in REPRS) if meas
+                      else f"{demo} tau={off} {outcome}", flush=True)
+            except Exception as e:
+                print(f"{demo} tau={off} SKIP {type(e).__name__}: {str(e)[:60]}", flush=True)
+    fout.close()
+    print("wrote", args.out)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/examples/kinova/convert_kinova_data_to_lerobot.py b/examples/kinova/convert_kinova_data_to_lerobot.py
new file mode 100644
index 0000000..e236b4e
--- /dev/null
+++ b/examples/kinova/convert_kinova_data_to_lerobot.py
@@ -0,0 +1,163 @@
+import dataclasses
+import pathlib
+import shutil
+
+import h5py
+from lerobot.common.datasets.lerobot_dataset import HF_LEROBOT_HOME
+from lerobot.common.datasets.lerobot_dataset import LeRobotDataset
+import numpy as np
+import tqdm
+import tyro
+
+DATA_DIR = pathlib.Path("~/kinova_dataset/data").expanduser()
+
+SPLITS = {
+    "sim": ["simple.hdf5"],
+    "real": ["grid_synced_fimg.hdf5"],
+    "sim_d10": ["simple_d10.hdf5"],
+    "sim_d30": ["simple_d30.hdf5"],
+    "sim_d50": ["simple_d50.hdf5"],
+    "sim_d80": ["simple_d80.hdf5"],
+    "sp09": ["simple_sp09.hdf5"],
+    "sp13": ["simple_sp13.hdf5"],
+    "home64": ["home64.hdf5"],
+    "home192": ["home192.hdf5"],
+    "home516": ["home516.hdf5"],
+    "home64_v2": ["home64_v2.hdf5"],
+    "home192_v2": ["home192_v2.hdf5"],
+    "home320_v2": ["home320_v2.hdf5"],
+    "home516_v2": ["home516_v2.hdf5"],
+}
+
+
+@dataclasses.dataclass
+class Stats:
+    episodes: int = 0
+    frames: int = 0
+    tasks: set[str] = dataclasses.field(default_factory=set)
+
+
+def demo_key(name: str) -> int:
+    return int(name.split("_")[1])
+
+
+def read_language(group) -> str:
+    lang = group.attrs["language"]
+    return lang.decode() if isinstance(lang, bytes) else str(lang)
+
+
+def build_state(ee_pos: np.ndarray, ee_quat: np.ndarray, gripper: np.ndarray) -> np.ndarray:
+    quat = np.asarray(ee_quat, np.float32)
+    norm = float(np.linalg.norm(quat))
+    if not abs(norm - 1.0) < 1e-3:
+        raise ValueError(f"ee_quat is not unit norm: {norm}")
+    state = np.concatenate(
+        [
+            np.asarray(ee_pos, np.float32),
+            quat,
+            np.asarray([np.asarray(gripper, np.float32).reshape(-1)[0]], np.float32),
+        ]
+    )
+    if state.shape != (8,):
+        raise ValueError(f"expected 8-dim state, got {state.shape}")
+    return state
+
+
+def image_shape(paths: list[pathlib.Path]) -> tuple[int, int, int]:
+    with h5py.File(paths[0], "r") as f:
+        data = f["data"]
+        first = data[sorted(data.keys(), key=demo_key)[0]]
+        shape = first["obs/agentview_rgb"].shape[1:]
+    return tuple(int(x) for x in shape)
+
+
+def main(
+    split: str,
+    repo_id: str | None = None,
+    data_dir: pathlib.Path = DATA_DIR,
+    fps: int = 20,
+    max_episodes: int | None = None,
+    subset: str = "all",
+    val_stride: int = 10,
+) -> None:
+    if split not in SPLITS:
+        raise ValueError(f"split must be one of {sorted(SPLITS)}, got {split!r}")
+    if subset not in ("all", "train", "val"):
+        raise ValueError(f"subset must be all/train/val, got {subset!r}")
+    repo_id = repo_id or f"kinova/{split}"
+    paths = [data_dir / name for name in SPLITS[split]]
+    for path in paths:
+        if not path.exists():
+            raise FileNotFoundError(path)
+
+    hwc = image_shape(paths)
+    print(f"[{split}] images {hwc} from {[p.name for p in paths]}", flush=True)
+
+    out = HF_LEROBOT_HOME / repo_id
+    if out.exists():
+        shutil.rmtree(out)
+
+    dataset = LeRobotDataset.create(
+        repo_id=repo_id,
+        robot_type="kinova3",
+        fps=fps,
+        features={
+            "image": {"dtype": "image", "shape": hwc, "names": ["height", "width", "channel"]},
+            "wrist_image": {"dtype": "image", "shape": hwc, "names": ["height", "width", "channel"]},
+            "state": {"dtype": "float32", "shape": (8,), "names": ["state"]},
+            "actions": {"dtype": "float32", "shape": (7,), "names": ["actions"]},
+        },
+        image_writer_threads=10,
+        image_writer_processes=5,
+    )
+
+    stats = Stats()
+    for path in paths:
+        with h5py.File(path, "r") as f:
+            data = f["data"]
+            names = sorted(data.keys(), key=demo_key)
+            if subset == "val":
+                names = [n for i, n in enumerate(names) if i % val_stride == val_stride - 1]
+            elif subset == "train":
+                names = [n for i, n in enumerate(names) if i % val_stride != val_stride - 1]
+            if max_episodes is not None:
+                names = names[:max_episodes]
+            for name in tqdm.tqdm(names, desc=path.name):
+                demo = data[name]
+                obs = demo["obs"]
+                actions = np.asarray(demo["actions"], np.float32)
+                length = actions.shape[0]
+                if actions.shape != (length, 7):
+                    raise ValueError(f"{name}: expected (T,7) actions, got {actions.shape}")
+
+                task = read_language(demo)
+                agentview = np.asarray(obs["agentview_rgb"])
+                wrist = np.asarray(obs["eye_in_hand_rgb"])
+                ee_pos = np.asarray(obs["ee_pos"])
+                ee_quat = np.asarray(obs["ee_quat"])
+                gripper = np.asarray(obs["gripper_states"])
+                if agentview.shape != (length, *hwc) or agentview.dtype != np.uint8:
+                    raise ValueError(f"{name}: bad agentview {agentview.shape} {agentview.dtype}")
+
+                for i in range(length):
+                    dataset.add_frame(
+                        {
+                            "image": agentview[i],
+                            "wrist_image": wrist[i],
+                            "state": build_state(ee_pos[i], ee_quat[i], gripper[i]),
+                            "actions": actions[i],
+                            "task": task,
+                        }
+                    )
+                dataset.save_episode()
+
+                stats.episodes += 1
+                stats.frames += length
+                stats.tasks.add(task)
+
+    print(f"[{split}] wrote {stats.episodes} episodes / {stats.frames} frames to {out}", flush=True)
+    print(f"[{split}] tasks: {sorted(stats.tasks)}", flush=True)
+
+
+if __name__ == "__main__":
+    tyro.cli(main)
