@@ -0,0 +1,128 @@
+import argparse
+import csv
+import pathlib
+import sys
+
+import numpy as np
+
+DATA = str(pathlib.Path("~/kinova_dataset/data/simple.hdf5").expanduser())
+
+
+def build_state(obs):
+    return np.concatenate([
+        np.asarray(obs["robot0_eef_pos"], np.float32),
+        np.asarray(obs["robot0_eef_quat"], np.float32),
+        np.asarray(obs["robot0_gripper_qpos"], np.float32).reshape(-1)[:1],
+    ]).astype(np.float32)
+
+
+def elem(obs, prompt):
+    return {"observation/image": np.asarray(obs["agentview_image"], np.uint8),
+            "observation/wrist_image": np.asarray(obs["robot0_eye_in_hand_image"], np.uint8),
+            "observation/state": build_state(obs), "prompt": prompt}
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--host", default="0.0.0.0")
+    ap.add_argument("--port", type=int, default=8000)
+    ap.add_argument("--env-dir", default=str(pathlib.Path("~/kinova_dataset/simple_env").expanduser()))
+    ap.add_argument("--demos", required=True)
+    ap.add_argument("--offsets", default="-2,-5,-10,-20,-35", help="grasp-relative (pre-grasp) switch steps")
+    ap.add_argument("--exec-horizon", type=int, default=5)
+    ap.add_argument("--max-steps", type=int, default=260)
+    ap.add_argument("--out-dir", required=True)
+    ap.add_argument("--csv", required=True)
+    args = ap.parse_args()
+
+    import h5py
+    sys.path.insert(0, args.env_dir)
+    import kinova_simple_env as kse
+    from openpi_client import websocket_client_policy
+    policy = websocket_client_policy.WebsocketClientPolicy(args.host, args.port)
+
+    out = pathlib.Path(args.out_dir); out.mkdir(parents=True, exist_ok=True)
+    pathlib.Path(args.csv).parent.mkdir(parents=True, exist_ok=True)
+    f = h5py.File(DATA, "r")["data"]
+
+    def grasp_of(demo):
+        g = np.asarray(f[demo]["obs"]["gripper_states"])[:, 0]
+        thr = g.min() + 0.2 * (g.max() - g.min()); cl = g > thr
+        return next((i for i in range(len(cl) - 5) if cl[i:i + 5].all()), int(np.argmax(cl)))
+
+    def lang(d):
+        la = f[d].attrs["language"]
+        return la.decode() if isinstance(la, bytes) else str(la)
+    langs = {}
+    for k in f:
+        la = lang(k)
+        langs.setdefault("red" if "red" in la.lower() else "yellow", la)
+
+    env = kse.make_simple_env(128, obj_center=(0.0, 0.1))
+    fout = open(args.csv, "w", newline="")
+    w = csv.DictWriter(fout, fieldnames=["name", "demo", "tau", "S", "outcome", "label",
+                                         "d_old", "d_new", "z_above_old", "gripper"])
+    w.writeheader()
+
+    for demo in args.demos.split(","):
+        la = lang(demo)
+        old_i = 0 if "red" in la.lower() else 1
+        new_i = 1 - old_i
+        old_c = "red" if old_i == 0 else "yellow"
+        new_c = "yellow" if old_i == 0 else "red"
+        gt = grasp_of(demo)
+        st0 = np.asarray(f[demo]["states"][0], np.float64)
+
+        for off in [int(o) for o in args.offsets.split(",")]:
+            S = max(1, gt + off)
+            try:
+                env.reset(); env.sim.set_state_from_flattened(st0); env.sim.forward()
+                env._spec["target_idx"] = new_i
+                obs = env._get_observations(force_update=True)
+                saved = None
+                steps = 0; followed = stuck = False
+                while steps < args.max_steps and not followed and not stuck:
+                    if steps >= S and saved is None:
+                        ee = np.asarray(obs["robot0_eef_pos"], float)
+                        po = np.array(env.sim.data.body_xpos[env.obj_body_ids[old_i]])
+                        pn = np.array(env.sim.data.body_xpos[env.obj_body_ids[new_i]])
+                        name = f"{demo}_t{off}"
+                        np.savez_compressed(
+                            out / f"{name}.npz",
+                            image=np.asarray(obs["agentview_image"], np.uint8),
+                            wrist=np.asarray(obs["robot0_eye_in_hand_image"], np.uint8),
+                            state=build_state(obs),
+                            prompt_old=langs[old_c], prompt_new=langs[new_c])
+                        saved = dict(name=name, demo=demo, tau=off, S=S,
+                                     d_old=round(float(np.linalg.norm(ee[:2] - po[:2])), 4),
+                                     d_new=round(float(np.linalg.norm(ee[:2] - pn[:2])), 4),
+                                     z_above_old=round(float(ee[2] - po[2]), 4),
+                                     gripper=round(float(np.asarray(obs["robot0_gripper_qpos"])[0]), 4))
+                    prompt = langs[new_c] if steps >= S else langs[old_c]
+                    chunk = np.asarray(policy.infer(elem(obs, prompt))["actions"], np.float64)
+                    for action in chunk[: args.exec_horizon]:
+                        obs, _, _, _ = env.step(action)
+                        steps += 1
+                        po = np.array(env.sim.data.body_xpos[env.obj_body_ids[old_i]])
+                        if steps >= S and env._check_success():
+                            followed = True; break
+                        gx, gy = env.guideline_xy; half = env.guideline_size / 2.0
+                        rest_z = float(env.table_offset[2]) + 0.002 + env._success_rest_z
+                        if abs(po[0] - gx) <= half and abs(po[1] - gy) <= half and po[2] < rest_z:
+                            stuck = True; break
+                    if steps > S + 220:
+                        break
+                outcome = "follow" if followed else ("stuck" if stuck else "neither")
+                if saved:
+                    saved.update(outcome=outcome,
+                                 label={"follow": "O", "stuck": "X", "neither": "∅"}[outcome])
+                    w.writerow(saved); fout.flush()
+                    print(f"{demo} tau={off:4d} -> {outcome}", flush=True)
+            except Exception as e:
+                print(f"{demo} tau={off} SKIP {type(e).__name__}: {str(e)[:60]}", flush=True)
+    fout.close()
+    print("wrote", args.csv)
+
+
+if __name__ == "__main__":
+    main()
