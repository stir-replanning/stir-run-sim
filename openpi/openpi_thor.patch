+  echo SERVER_TIMEOUT
+  exit 1
+}
+chain0 &
+chain1 &
+chain2 &
+chain3 &
+wait
+echo "===== SWEEP3 DEPTH SUMMARY ====="
+$ENVPY - <<'PY'
+import csv,glob,collections,os
+for f in sorted(glob.glob('results/inject/S[234]0_*.csv')):
+    lab=os.path.basename(f)[:-4]; rows=list(csv.DictReader(open(f))); n=len(rows)
