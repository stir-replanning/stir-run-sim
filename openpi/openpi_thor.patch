+import os
+import sys
+
+os.environ.setdefault("CUDA_VISIBLE_DEVICES", "0")
+os.environ.setdefault("JAX_PLATFORMS", "")
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+import jax
+import jax.numpy as jnp
+import numpy as np
+
+import serve_policy_inject as spi
+from openpi.models import model as _model
+from openpi.policies import policy_config as _policy_config
+from openpi.training import config as _config
+
+CKPT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "../../../checkpoints/pi05_kinova_sim/pi05_kinova_sim/29999")
+TOL = 1e-4
+
+cfg = _config.get_config("pi05_kinova_sim")
+policy = _policy_config.create_trained_policy(cfg, CKPT)
+model = policy._model
+tf = policy._input_transform
+
+rng_np = np.random.RandomState(0)
+img = rng_np.randint(0, 256, (224, 224, 3), np.uint8)
+wrist = rng_np.randint(0, 256, (224, 224, 3), np.uint8)
+state = rng_np.rand(8).astype(np.float32)
+PROMPT = "pick up the red cube"
+PROMPT2 = "pick up the yellow cube"
+
+
+def obs_for(prompt):
+    d = {
+        "observation/image": img,
+        "observation/wrist_image": wrist,
+        "observation/state": state,
+        "prompt": prompt,
+    }
+    d = tf(jax.tree.map(lambda x: x, d))
+    d = jax.tree.map(lambda x: jnp.asarray(x)[None, ...], d)
+    return _model.Observation.from_dict(d)
+
+
+obs = obs_for(PROMPT)
+noise = jax.random.normal(jax.random.key(123), (1, model.action_horizon, model.action_dim))
+rng = jax.random.key(0)
+
+print("=" * 70)
+print("action_dim =", model.action_dim, " action_horizon =", model.action_horizon)
+dbg = spi.injection_debug(model, obs_for(PROMPT), obs_for(PROMPT2))
+for k, v in dbg.items():
+    print(f"  {k:16s} {v}")
+print("=" * 70)
+
+base = np.asarray(model.sample_actions(rng, obs, noise=noise))
+
+
+def maxdiff(a, b):
+    return float(np.max(np.abs(np.asarray(a) - np.asarray(b))))
+
+
+a0 = spi.sample_actions_injected(
+    model, rng, obs_for(PROMPT), obs_for(PROMPT), inject_site="A", inject_scale=0.0, noise=noise
+)
+c0 = spi.sample_actions_injected(
+    model, rng, obs_for(PROMPT), obs_for(PROMPT), inject_site="C", inject_scale_c=0.0, noise=noise
+)
+n0 = spi.sample_actions_injected(model, rng, obs_for(PROMPT), obs_for(PROMPT), inject_site="none", noise=noise)
+
+d_a0 = maxdiff(a0, base)
+d_c0 = maxdiff(c0, base)
+d_n0 = maxdiff(n0, base)
+print(f"[oracle] site=A  s=0.0   max|diff vs stock| = {d_a0:.3e}")
+print(f"[oracle] site=C  w=0.0   max|diff vs stock| = {d_c0:.3e}")
+print(f"[oracle] site=none       max|diff vs stock| = {d_n0:.3e}")
+
+a_gate_closed = spi.sample_actions_injected(
+    model, rng, obs_for(PROMPT), obs_for(PROMPT2),
+    inject_site="A", inject_scale=1.5, gate_thresh=0.0, noise=noise,
+)
+d_gate = maxdiff(a_gate_closed, base)
+print(f"[oracle] site=A  s=1.5 gate=0.0(closed)  max|diff vs stock| = {d_gate:.3e}")
+
+assert dbg["d_img"] > 0.0, "d_img must be > 0 for different prompts"
+assert dbg["v_diff_img_norm"] > 0.0, "image-position V-diff must be nonzero"
+
+a15 = spi.sample_actions_injected(
+    model, rng, obs_for(PROMPT), obs_for(PROMPT2), inject_site="A", inject_scale=1.5, noise=noise
+)
+c15 = spi.sample_actions_injected(
+    model, rng, obs_for(PROMPT), obs_for(PROMPT2), inject_site="C", inject_scale_c=1.5, noise=noise
+)
+ac15 = spi.sample_actions_injected(
+    model, rng, obs_for(PROMPT), obs_for(PROMPT2),
+    inject_site="AC", inject_scale=1.5, inject_scale_c=1.5, noise=noise,
+)
+d_a15 = maxdiff(a15, base)
+d_c15 = maxdiff(c15, base)
+d_ac15 = maxdiff(ac15, base)
+print(f"[sanity] site=A  s=1.5   max|diff vs stock| = {d_a15:.3e}  (must be > 1e-3)")
+print(f"[sanity] site=C  w=1.5   max|diff vs stock| = {d_c15:.3e}  (must be > 1e-3)")
+print(f"[sanity] site=AC s=w=1.5 max|diff vs stock| = {d_ac15:.3e}  (must be > 1e-3)")
+
+sampler = spi._InjectSampler(model, num_steps=10)
+ja0 = sampler(rng, obs_for(PROMPT), obs_for(PROMPT), inject_site="A", inject_scale=0.0,
+              inject_scale_c=0.0, gate_thresh=None, noise=noise)
+ja15 = sampler(rng, obs_for(PROMPT), obs_for(PROMPT2), inject_site="A", inject_scale=1.5,
+               inject_scale_c=0.0, gate_thresh=None, noise=noise)
+d_ja0 = maxdiff(ja0, base)
+d_ja15_vs_eager = maxdiff(ja15, a15)
+print(f"[jit]    site=A  s=0.0   max|diff vs stock|  = {d_ja0:.3e}")
+print(f"[jit]    site=A  s=1.5   max|diff vs eager|  = {d_ja15_vs_eager:.3e}")
+
+print("=" * 70)
+ok = True
+for name, d in [("A s=0", d_a0), ("C w=0", d_c0), ("none", d_n0), ("A gate-closed", d_gate), ("jit A s=0", d_ja0)]:
+    passed = d <= TOL
+    ok = ok and passed
+    print(f"  ORACLE {name:14s} {'PASS' if passed else 'FAIL'}  ({d:.3e} <= {TOL:.0e})")
+for name, d in [("A s=1.5", d_a15), ("C w=1.5", d_c15), ("AC", d_ac15)]:
+    passed = d > 1e-3
+    ok = ok and passed
+    print(f"  SANITY {name:14s} {'PASS' if passed else 'FAIL'}  ({d:.3e} > 1e-3)")
+print("=" * 70)
+print("ALL PASS" if ok else "FAILURES PRESENT")
+sys.exit(0 if ok else 1)
