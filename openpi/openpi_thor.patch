+++ b/examples/kinova/inject_sweeps/run_sweep4.sh
@@ -0,0 +1,68 @@
+#!/bin/bash
+cd "${OPENPI_DIR:-$HOME/openpi}"
+ENVPY=${KINOVA_EVAL_VENV:-$HOME/envs/kinova_eval}/bin/python
+export LD_LIBRARY_PATH=${GLVND_DIR:-$HOME/envs/glvnd}/lib:/usr/lib/x86_64-linux-gnu
+export __EGL_VENDOR_LIBRARY_DIRS=/usr/share/glvnd/egl_vendor.d
+export MUJOCO_GL=egl PYOPENGL_PLATFORM=egl
+S=50
+N=24
+OUT=results/inject
+mkdir -p $OUT
+wait_port() {
+  for i in $(seq 1 120); do
+    (echo >/dev/tcp/127.0.0.1/$1) 2>/dev/null && return 0
+    sleep 3
+  done
+  return 1
+}
+run_arm() {
+  local port=$1 egl=$2 label=$3 site=$4 s=$5 gate=$6 nosw=$7
+  local args="--port $port --switch-step $S --limit-per-task $N --inject-site $site --inject-scale $s --inject-scale-c 0 --csv $OUT/$label.csv --label $label"
+  [ "$gate" != "none" ] && args="$args --gate-thresh $gate"
+  [ "$nosw" = "1" ] && args="$args --no-switch"
+  echo "[START $label]"
+  MUJOCO_EGL_DEVICE_ID=$egl $ENVPY examples/kinova/eval_kinova_switch_inject.py $args >$OUT/$label.log 2>&1
+  echo "[DONE $label] rc=$?"
+}
+chain0() {
+  run_arm 8010 0 Arand_s0.5 Arand 0.5 none 0
+  run_arm 8010 0 Arand_s1.0 Arand 1.0 none 0
+}
+chain1() {
+  run_arm 8011 1 Arand_s2.0 Arand 2.0 none 0
+  run_arm 8011 1 baseinj_A_s0 A 0 none 1
+}
+chain2() { run_arm 8012 2 baseinj_A_s1 A 1.0 none 1; }
+chain3() { run_arm 8013 3 baseinj_A_s2 A 2.0 none 1; }
+wait_port 8010 && wait_port 8011 && wait_port 8012 && wait_port 8013 || {
+  echo SERVER_TIMEOUT
+  exit 1
+}
+chain0 &
+chain1 &
+chain2 &
+chain3 &
+wait
+echo "===== GUARDRAIL SUMMARY (S=$S N=$((2 * N))) ====="
+$ENVPY - <<'PY'
+import csv,glob,collections,os
+def stat(f):
+    rows=list(csv.DictReader(open(f))); n=len(rows)
+    if n==0: return None
+    t=collections.Counter(r['outcome'] for r in rows)
+    appr=sum(int(r['approached_new']) for r in rows)
+    return n,t,appr
+print("-- random-direction (compare to A_ung same s) --")
+for lab in ['Arand_s0.5','A_ung_s0.5','Arand_s1.0','A_ung_s1.0','Arand_s2.0','A_ung_s2.0','none']:
+    f=f'results/inject/{lab}.csv'
+    if not os.path.exists(f): continue
+    n,t,appr=stat(f)
+    print(f"  {lab:14s} n={n:3d} follow={100*t['follow']/n:5.1f}% neither={100*t['neither']/n:5.1f}% appr_new={100*appr/n:5.1f}%")
+print("-- base-replay + injection (base place-success; s0=placebo) --")
+for lab in ['baserep_none','baseinj_A_s0','baseinj_A_s1','baseinj_A_s2']:
+    f=f'results/inject/{lab}.csv'
+    if not os.path.exists(f): continue
+    n,t,appr=stat(f)
+    print(f"  {lab:14s} n={n:3d} base_ok={100*t['base_ok']/n:5.1f}% base_fail={100*t['base_fail']/n:5.1f}%")
+PY
+echo GUARDRAIL_DONE
