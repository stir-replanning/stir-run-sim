@@ -0,0 +1,142 @@
+import argparse
+import csv
+import glob
+import math
+import pathlib
+
+import jax
+import jax.numpy as jnp
+import numpy as np
+
+
+def cos_dist(a, b):
+    a = np.asarray(a, np.float32).reshape(a.shape[0], -1) if a.ndim > 2 else np.asarray(a, np.float32)
+    b = np.asarray(b, np.float32).reshape(b.shape[0], -1) if b.ndim > 2 else np.asarray(b, np.float32)
+    na = np.linalg.norm(a, axis=-1) + 1e-9
+    nb = np.linalg.norm(b, axis=-1) + 1e-9
+    return float(np.mean(1.0 - (a * b).sum(-1) / (na * nb)))
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--config", default="pi05_kinova_sim")
+    ap.add_argument("--ckpt", required=True)
+    ap.add_argument("--obs-dir", required=True)
+    ap.add_argument("--outcomes", required=True, help="csv from save_switch_obs.py")
+    ap.add_argument("--n", type=int, default=200,
+                    help="action samples per prompt; 7-dim KDE needs plenty")
+    ap.add_argument("--out", required=True)
+    args = ap.parse_args()
+
+    from openpi.models import model as _model
+    from openpi.policies import policy_config as _policy_config
+    from openpi.training import config as _config
+
+    train_cfg = _config.get_config(args.config)
+    policy = _policy_config.create_trained_policy(train_cfg, args.ckpt)
+    model = policy._model
+    tf = policy._input_transform
+
+    def observation_for(img, wrist, state, prompt):
+        d = tf({"observation/image": img, "observation/wrist_image": wrist,
+                "observation/state": state, "prompt": prompt})
+        d = jax.tree.map(lambda x: jnp.asarray(x)[np.newaxis, ...], d)
+        return _model.Observation.from_dict(d), d
+
+    def prefix_of(obs):
+        tokens, mask, ar = model.embed_prefix(obs)
+        attn = jnp.zeros((1, tokens.shape[1], tokens.shape[1]), bool) | True
+        pos = jnp.cumsum(mask, axis=1) - 1
+        (prefix_out, _), _ = model.PaliGemma.llm([tokens, None], mask=attn, positions=pos)
+        n_lang = int(obs.tokenized_prompt.shape[1]) if obs.tokenized_prompt is not None else 0
+        return np.asarray(prefix_out[0], np.float32), n_lang
+
+    rows = {r["name"]: r for r in csv.DictReader(open(args.outcomes))}
+    files = sorted(glob.glob(str(pathlib.Path(args.obs_dir) / "*.npz")))
+    print(f"{len(files)} frozen states, {len(rows)} outcomes")
+
+    fields = ["name", "demo", "tau", "label", "d_old", "d_new", "z_above_old", "gripper",
+              "d_lang", "d_img", "d_prefix", "cmi_xy", "cmi_xyz", "cmi_grip", "cmi_xyzg",
+              "cmi_full", "cmi_full_knn"]
+    fout = open(args.out, "w", newline="")
+    w = csv.DictWriter(fout, fieldnames=fields); w.writeheader()
+
+    from scipy.spatial import cKDTree
+    from scipy.special import digamma
+    from scipy.stats import gaussian_kde
+
+    def ent_kde(x):
+        x = np.atleast_2d(np.asarray(x, float))
+        if x.shape[0] <= x.shape[1] + 1:
+            return float("nan")
+        x = x + 1e-9 * np.random.randn(*x.shape)
+        try:
+            return float(-np.mean(np.log(gaussian_kde(x.T)(x.T) + 1e-12)))
+        except Exception:
+            return float("nan")
+
+    def ent_knn(x, k=5):
+        x = np.atleast_2d(np.asarray(x, float))
+        n, d = x.shape
+        if n <= k + 1:
+            return float("nan")
+        x = x + 1e-9 * np.random.randn(n, d)
+        dist, _ = cKDTree(x).query(x, k=k + 1)
+        eps = dist[:, k]
+        log_vd = (d / 2) * math.log(math.pi) - math.lgamma(d / 2 + 1)
+        return float(digamma(n) - digamma(k) + log_vd + d * np.mean(np.log(eps + 1e-12)))
+
+    def cmi_with(ent, a, b):
+        return float(ent(np.vstack([a, b])) - 0.5 * (ent(a) + ent(b)))
+
+    def cmi(a, b):
+        return cmi_with(ent_kde, a, b)
+
+    for fp in files:
+        name = pathlib.Path(fp).stem
+        if name not in rows:
+            continue
+        r = rows[name]
+        z = np.load(fp, allow_pickle=True)
+        img, wrist, st = z["image"], z["wrist"], z["state"]
+        p_old, p_new = str(z["prompt_old"]), str(z["prompt_new"])
+
+        obs_a, _ = observation_for(img, wrist, st, p_old)
+        obs_b, _ = observation_for(img, wrist, st, p_new)
+        pa, n_lang = prefix_of(obs_a)
+        pb, _ = prefix_of(obs_b)
+        n_img = pa.shape[0] - n_lang
+
+        d_img = cos_dist(pa[:n_img], pb[:n_img])
+        d_lang = cos_dist(pa[n_img:], pb[n_img:])
+        d_prefix = cos_dist(pa, pb)
+
+        acts = {}
+        for tag, prompt in (("a", p_old), ("b", p_new)):
+            out = [policy.infer({"observation/image": img, "observation/wrist_image": wrist,
+                                 "observation/state": st, "prompt": prompt})["actions"]
+                   for _ in range(args.n)]
+            acts[tag] = np.asarray(out)
+        A, B = acts["a"], acts["b"]
+        m = dict(
+            cmi_xy=cmi(A[:, :, :2].sum(1), B[:, :, :2].sum(1)),
+            cmi_xyz=cmi(A[:, :, :3].sum(1), B[:, :, :3].sum(1)),
+            cmi_grip=cmi(A[:, :, 6:7].sum(1), B[:, :, 6:7].sum(1)),
+            cmi_xyzg=cmi(A[:, :, [0, 1, 2, 6]].sum(1), B[:, :, [0, 1, 2, 6]].sum(1)),
+            cmi_full=cmi(A.sum(1), B.sum(1)),
+            cmi_full_knn=cmi_with(ent_knn, A.sum(1), B.sum(1)),
+        )
+        w.writerow(dict(name=name, demo=r["demo"], tau=r["tau"], label=r["label"],
+                        d_old=r["d_old"], d_new=r["d_new"], z_above_old=r["z_above_old"],
+                        gripper=r["gripper"],
+                        d_lang=round(d_lang, 4), d_img=round(d_img, 4), d_prefix=round(d_prefix, 4),
+                        **{k: round(v, 4) for k, v in m.items()}))
+        fout.flush()
+        print(f"{name} tau={r['tau']:>4s} {r['label']}  d_img={d_img:.4f} d_prefix={d_prefix:.4f} "
+              f"cmi_xy={m['cmi_xy']:+.2f} cmi_grip={m['cmi_grip']:+.2f}", flush=True)
+    fout.close()
+    print("wrote", args.out)
+
+
+if __name__ == "__main__":
+    main()
