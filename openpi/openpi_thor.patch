+++ b/examples/kinova/inject_sweeps/run_sweep.sh
@@ -0,0 +1,73 @@
+#!/bin/bash
+cd "${OPENPI_DIR:-$HOME/openpi}"
+ENVPY=${KINOVA_EVAL_VENV:-$HOME/envs/kinova_eval}/bin/python
+export LD_LIBRARY_PATH=${GLVND_DIR:-$HOME/envs/glvnd}/lib:/usr/lib/x86_64-linux-gnu
+export __EGL_VENDOR_LIBRARY_DIRS=/usr/share/glvnd/egl_vendor.d
+export MUJOCO_GL=egl PYOPENGL_PLATFORM=egl
+S=50
+N=24
+OUT=results/inject
+mkdir -p $OUT
+wait_port() {
+  for i in $(seq 1 120); do
+    (echo >/dev/tcp/127.0.0.1/$1) 2>/dev/null && return 0
+    sleep 3
+  done
+  return 1
+}
+run_arm() {
+  local port=$1 egl=$2 label=$3 site=$4 s=$5 w=$6 gate=$7 nosw=$8
+  local args="--port $port --switch-step $S --limit-per-task $N --inject-site $site --inject-scale $s --inject-scale-c $w --csv $OUT/$label.csv --label $label"
+  [ "$gate" != "none" ] && args="$args --gate-thresh $gate"
+  [ "$nosw" = "1" ] && args="$args --no-switch"
+  echo "[START $label]"
+  MUJOCO_EGL_DEVICE_ID=$egl $ENVPY examples/kinova/eval_kinova_switch_inject.py $args >$OUT/$label.log 2>&1
+  echo "[DONE $label] rc=$?"
+}
+chain0() {
+  run_arm 8010 0 none none 0 0 none 0
+  run_arm 8010 0 A_ung_s1.5 A 1.5 0 none 0
+  run_arm 8010 0 AC_gate AC 1.5 1.0 0.051 0
+}
+chain1() {
+  run_arm 8011 1 A_ung_s1.0 A 1.0 0 none 0
+  run_arm 8011 1 A_ung_s2.0 A 2.0 0 none 0
+  run_arm 8011 1 baserep_none none 0 0 none 1
+}
+chain2() {
+  run_arm 8012 2 A_gate_s1.0 A 1.0 0 0.051 0
+  run_arm 8012 2 A_gate_s1.5 A 1.5 0 0.051 0
+  run_arm 8012 2 A_gate_s2.0 A 2.0 0 0.051 0
+}
+chain3() {
+  run_arm 8013 3 C_uni_w1.0 C 0 1.0 none 0
+  run_arm 8013 3 C_uni_w1.5 C 0 1.5 none 0
+}
+echo "waiting for 4 servers..."
+wait_port 8010 && wait_port 8011 && wait_port 8012 && wait_port 8013 || {
+  echo "SERVER_TIMEOUT"
+  exit 1
+}
+echo "all servers up; launching 4 parallel chains"
+chain0 &
+chain1 &
+chain2 &
+chain3 &
+wait
+echo "===== SWEEP SUMMARY (S=$S, N/arm=$((2 * N))) ====="
+$ENVPY - <<'PY'
+import csv,glob,collections,os
+rows=[]
+for f in sorted(glob.glob('results/inject/*.csv')):
+    lab=os.path.basename(f)[:-4]
+    if lab.startswith('smoke'): continue
+    t=collections.Counter()
+    for r in csv.DictReader(open(f)): t[r['outcome']]+=1
+    n=sum(t.values())
+    if n==0: continue
+    if t['base_ok']+t['base_fail']>0:
+        print(f"{lab:14s} n={n:3d}  base_ok={100*t['base_ok']/n:5.1f}%")
+    else:
+        print(f"{lab:14s} n={n:3d}  follow={100*t['follow']/n:5.1f}%  stuck={100*t['stuck']/n:4.1f}%  neither={100*t['neither']/n:5.1f}%")
+PY
+echo "SWEEP_DONE"
