+
+DEFAULT_HDF5 = str(pathlib.Path("~/kinova_dataset/data/simple.hdf5").expanduser())
+DEFAULT_ENV_DIR = str(pathlib.Path("~/kinova_dataset/simple_env").expanduser())
+
+COLOUR = {0: "red", 1: "yellow"}
+CELL = {0: "L", 1: "R"}
+APPROACH_DIST = 0.06
+LIFT_HEIGHT = 0.03
+
+
+def read_language(group) -> str:
+    lang = group.attrs["language"]
+    return lang.decode() if isinstance(lang, bytes) else str(lang)
+
+
+def build_state(obs: dict) -> np.ndarray:
+    return np.concatenate(
+        [
+            np.asarray(obs["robot0_eef_pos"], np.float32),
+            np.asarray(obs["robot0_eef_quat"], np.float32),
+            np.asarray(obs["robot0_gripper_qpos"], np.float32).reshape(-1)[:1],
+        ]
+    ).astype(np.float32)
+
+
+def object_speed(env, index: int) -> float:
+    model = env.sim.model
+    joint = model.joint_name2id(env._objs[index].joints[0])
+    address = model.jnt_dofadr[joint]
+    return float(np.linalg.norm(env.sim.data.qvel[address : address + 3]))
+
+
+def scripted_lever_action(env, obs, new_idx, is_lift, gain, lift, cap) -> np.ndarray:
+    if is_lift:
+        return np.array([0.0, 0.0, lift, 0.0, 0.0, 0.0, -1.0], np.float64)
+    ee = np.asarray(obs["robot0_eef_pos"], np.float64)
+    pos_new = np.asarray(env.sim.data.body_xpos[env.obj_body_ids[new_idx]], np.float64)
+    t = np.clip(gain * (pos_new - ee), -cap, cap)
+    return np.array([t[0], t[1], t[2], 0.0, 0.0, 0.0, -1.0], np.float64)
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--host", default="0.0.0.0")
+    ap.add_argument("--port", type=int, default=8010)
+    ap.add_argument("--switch-step", type=int, required=True, help="step at which the instruction flips")
+    ap.add_argument("--hdf5", default=DEFAULT_HDF5)
+    ap.add_argument("--env-dir", default=DEFAULT_ENV_DIR)
+    ap.add_argument("--limit-per-task", type=int, default=24, help="demos per original target, 0 = all")
+    ap.add_argument("--exec-horizon", type=int, default=5)
+    ap.add_argument("--max-steps", type=int, default=400)
+    ap.add_argument("--inject-site", default="none", choices=["none", "A", "C", "AC", "Arand"])
+    ap.add_argument("--inject-scale", type=float, default=0.0, help="site A scale s")
+    ap.add_argument("--inject-scale-c", type=float, default=0.0, help="site C scale w")
+    ap.add_argument("--gate-thresh", type=float, default=None,
+                    help="inject only when d_img(new,old) < this; omit = ungated")
+    ap.add_argument("--no-switch", action="store_true",
+                    help="base-task control: keep the original goal, no injection")
+    ap.add_argument("--action-lever", action="store_true",
+                    help="after switch, hand-drive a scripted release+lift+move-to-new for a window, then return control to the policy")
+    ap.add_argument("--lever-steps", type=int, default=10, help="total scripted env-steps after switch")
+    ap.add_argument("--lever-lift-steps", type=int, default=4, help="of those, first N = release+lift (retreat)")
+    ap.add_argument("--lever-gain", type=float, default=8.0, help="closed-loop P-gain toward the new cube")
+    ap.add_argument("--lever-lift", type=float, default=0.3, help="upward command magnitude during retreat")
+    ap.add_argument("--lever-cap", type=float, default=0.4, help="clip on scripted translation command")
+    ap.add_argument("--csv", default=None)
+    ap.add_argument("--label", default="inject")
+    args = ap.parse_args()
+
+    sys.path.insert(0, args.env_dir)
+    import kinova_simple_env as kse
+    from openpi_client import websocket_client_policy
+
+    policy = websocket_client_policy.WebsocketClientPolicy(args.host, args.port)
+    print(f"connected to policy server {args.host}:{args.port}", flush=True)
+    print(f"inject_site={args.inject_site} s={args.inject_scale} w={args.inject_scale_c} "
+          f"gate={args.gate_thresh} no_switch={args.no_switch}", flush=True)
+
+    handle = h5py.File(args.hdf5, "r")
+    data = handle["data"]
+    kwargs = json.loads(data.attrs["env_args"])["env_kwargs"]
+    env = kse.make_simple_env(
+        128,
+        obj_center=tuple(kwargs["obj_center"]),
+        obj_sep=float(kwargs["obj_sep"]),
+        obj_axis=kwargs.get("obj_axis", "x"),
+        guideline_xy=tuple(kwargs["guideline_xy"]),
+        guideline_size=float(kwargs["guideline_size"]),
+        cube_half=0.02,
+    )
+    guide_x, guide_y = env.guideline_xy
+    half = env.guideline_size / 2.0
+    rest_z = float(env.table_offset[2]) + 0.002 + env._success_rest_z
+    settle_speed = env._success_speed
+
+    by_target = collections.defaultdict(list)
+    language_of = {}
+    for name in sorted(data.keys(), key=lambda k: int(k.split("_")[1])):
+        idx = int(data[name].attrs["target_idx"])
+        by_target[idx].append(name)
+        language_of.setdefault(idx, read_language(data[name]))
+
+    selected = []
+    for target_idx in sorted(by_target):
+        names = by_target[target_idx]
+        selected += names if args.limit_per_task <= 0 else names[: args.limit_per_task]
+    print(f"switch_step={args.switch_step}  episodes={len(selected)}  exec_horizon={args.exec_horizon}", flush=True)
+
+    fields = [
+        "demo", "dir", "init_color", "cell", "obj_left_idx", "outcome",
+        "approached_new", "min_dist_new", "steps", "S",
+        "roll_grasp_old", "stuck_strict",
+        "inject_site", "inject_scale", "inject_scale_c", "gate_thresh", "no_switch",
+    ]
+    csv_file = None
+    writer = None
+    if args.csv:
+        path = pathlib.Path(args.csv)
+        path.parent.mkdir(parents=True, exist_ok=True)
+        csv_file = path.open("w", newline="")
+        writer = csv.DictWriter(csv_file, fieldnames=fields)
+        writer.writeheader()
+        csv_file.flush()
+
+    tally = collections.Counter()
+    by_direction = collections.defaultdict(collections.Counter)
+
+    for episode, name in enumerate(selected):
+        demo = data[name]
+        old_idx = int(demo.attrs["target_idx"])
+        new_idx = 1 - old_idx
+        cell = int(demo.attrs["target_cell"])
+        prompt_old = read_language(demo)
+        prompt_new = language_of[new_idx]
+
+        env.reset()
+        env.sim.set_state_from_flattened(np.asarray(demo["states"][0], np.float64))
+        env.sim.forward()
+        for robot in env.robots:
+            with contextlib.suppress(Exception):
+                robot.controller.reset_goal()
+        success_idx = old_idx if args.no_switch else new_idx
+        env._spec["target_idx"] = success_idx
+        env._spec["obj_left_idx"] = int(demo.attrs["obj_left_idx"])
+
+        obs = env._get_observations(force_update=True)
+        start_old = np.array(env.sim.data.body_xpos[env.obj_body_ids[old_idx]])
+
+        followed = stuck = False
+        stuck_strict = False
+        min_dist_new = 9.9
+        roll_grasp_old = -1
+        steps = 0
+        lever_remaining = 0
+        lever_fired = False
+
+        while steps < args.max_steps and not followed and not stuck:
+            switched = (not args.no_switch) and (steps >= args.switch_step)
+            if args.action_lever and switched and not lever_fired:
+                lever_remaining = args.lever_steps
+                lever_fired = True
+            prompt = prompt_new if switched else prompt_old
+            req = {
+                "observation/image": np.asarray(obs["agentview_image"], np.uint8),
+                "observation/wrist_image": np.asarray(obs["robot0_eye_in_hand_image"], np.uint8),
+                "observation/state": build_state(obs),
+                "prompt": prompt,
+            }
+            inject_now = args.inject_site != "none" and (switched or args.no_switch)
+            if inject_now:
+                req["prompt_contrast"] = prompt_new if args.no_switch else prompt_old
+                req["inject_site"] = args.inject_site
+                req["inject_scale"] = float(args.inject_scale)
+                req["inject_scale_c"] = float(args.inject_scale_c)
+                if args.gate_thresh is not None:
+                    req["gate_thresh"] = float(args.gate_thresh)
+
+            chunk = np.asarray(policy.infer(req)["actions"], np.float64)
+            for action in chunk[: args.exec_horizon]:
+                if lever_remaining > 0:
+                    is_lift = (args.lever_steps - lever_remaining) < args.lever_lift_steps
+                    action = scripted_lever_action(
+                        env, obs, new_idx, is_lift, args.lever_gain, args.lever_lift, args.lever_cap
+                    )
+                    lever_remaining -= 1
+                obs, _, _, _ = env.step(action)
+                steps += 1
+                ee = np.asarray(obs["robot0_eef_pos"])
+                pos_new = np.array(env.sim.data.body_xpos[env.obj_body_ids[new_idx]])
+                pos_old = np.array(env.sim.data.body_xpos[env.obj_body_ids[old_idx]])
+                if roll_grasp_old < 0 and float(pos_old[2] - start_old[2]) > LIFT_HEIGHT:
+                    roll_grasp_old = steps
+                if steps >= args.switch_step:
+                    min_dist_new = min(min_dist_new, float(np.linalg.norm(ee - pos_new)))
+                if env._check_success():
+                    followed = True
+                    break
+                if not args.no_switch:
+                    in_zone = abs(pos_old[0] - guide_x) <= half and abs(pos_old[1] - guide_y) <= half
+                    if in_zone and pos_old[2] < rest_z:
+                        if object_speed(env, new_idx) < settle_speed:
+                            stuck = True
+                        if object_speed(env, old_idx) < settle_speed:
+                            stuck_strict = True
+                        if stuck:
+                            break
+                if steps >= args.max_steps:
+                    break
+
+        if args.no_switch:
+            outcome = "base_ok" if followed else "base_fail"
+        else:
+            outcome = "follow" if followed else ("stuck" if stuck else "neither")
+        direction = f"{COLOUR[old_idx]}->{COLOUR[new_idx]}"
+        tally[outcome] += 1
+        by_direction[direction][outcome] += 1
+
+        row = {
+            "demo": name, "dir": direction, "init_color": COLOUR[old_idx], "cell": CELL[cell],
+            "obj_left_idx": int(demo.attrs["obj_left_idx"]), "outcome": outcome,
+            "approached_new": int(min_dist_new < APPROACH_DIST),
+            "min_dist_new": round(float(min_dist_new), 3), "steps": steps, "S": args.switch_step,
+            "roll_grasp_old": roll_grasp_old, "stuck_strict": int(stuck_strict),
+            "inject_site": args.inject_site, "inject_scale": args.inject_scale,
+            "inject_scale_c": args.inject_scale_c,
+            "gate_thresh": ("" if args.gate_thresh is None else args.gate_thresh),
+            "no_switch": int(args.no_switch),
+        }
+        if writer is not None:
+            writer.writerow(row)
+            csv_file.flush()
+        done = episode + 1
+        key = "base_ok" if args.no_switch else "follow"
+        print(
+            f"[{done}/{len(selected)}] {name} {direction:15s} {outcome:9s} steps={steps:3d} "
+            f"grasped_old@{roll_grasp_old:4d}  {key}={tally[key]}/{done}",
+            flush=True,
+        )
+
+    total = len(selected)
+    print(f"\n=== {args.label} site={args.inject_site} s={args.inject_scale} w={args.inject_scale_c} "
+          f"gate={args.gate_thresh} switch_step={args.switch_step}  n={total} ===")
+    outcomes = ("base_ok", "base_fail") if args.no_switch else ("follow", "stuck", "neither")
+    for outcome in outcomes:
+        count = tally[outcome]
+        print(f"  {outcome:9s} {count:4d}  ({100.0 * count / max(total, 1):.1f}%)")
+    print("\nby direction:")
+    for direction, counter in by_direction.items():
+        n = sum(counter.values())
+        primary = "base_ok" if args.no_switch else "follow"
+        print(f"  {direction:16s} {primary} {counter[primary]}/{n} ({100.0 * counter[primary] / max(n, 1):.0f}%)")
+
+    if csv_file is not None:
+        csv_file.close()
+        print(f"\nwrote {args.csv}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/examples/kinova/eval_offline.py b/examples/kinova/eval_offline.py
new file mode 100644
index 0000000..7498cd6
--- /dev/null
+++ b/examples/kinova/eval_offline.py
@@ -0,0 +1,94 @@
+import dataclasses
+
+from lerobot.common.datasets import lerobot_dataset
+import numpy as np
+import tyro
+
+import openpi.policies.policy_config as _policy_config
+import openpi.training.config as _config
+import openpi.transforms as _transforms
+
+GRIPPER_DIM = 6
+
+
+def to_hwc_uint8(image: np.ndarray) -> np.ndarray:
+    array = np.asarray(image)
+    if array.ndim == 3 and array.shape[0] == 3:
+        array = np.transpose(array, (1, 2, 0))
+    if np.issubdtype(array.dtype, np.floating):
+        array = (255.0 * array).round().clip(0, 255).astype(np.uint8)
+    return array
+
+
+@dataclasses.dataclass
+class Args:
+    config_name: str
+    checkpoint_dir: str
+    repo_id: str
+    num_frames: int = 512
+    seed: int = 0
+
+
+def main(args: Args) -> None:
+    train_config = _config.get_config(args.config_name)
+    horizon = train_config.model.action_horizon
+    policy = _policy_config.create_trained_policy(train_config, args.checkpoint_dir)
+
+    meta = lerobot_dataset.LeRobotDatasetMetadata(args.repo_id)
+    dataset = lerobot_dataset.LeRobotDataset(
+        args.repo_id,
+        delta_timestamps={"actions": [t / meta.fps for t in range(horizon)]},
+    )
+    prompt_from_task = _transforms.PromptFromLeRobotTask(meta.tasks)
+
+    rng = np.random.default_rng(args.seed)
+    indices = rng.choice(len(dataset), size=min(args.num_frames, len(dataset)), replace=False)
+    print(
+        f"{args.config_name} on {args.repo_id}: {meta.total_episodes} episodes, "
+        f"{len(dataset)} frames, scoring {len(indices)} of them, horizon {horizon}",
+        flush=True,
+    )
+
+    errors = []
+    gripper_hits = 0
+    for count, index in enumerate(indices, start=1):
+        item = prompt_from_task(dict(dataset[int(index)]))
+        predicted = np.asarray(
+            policy.infer(
+                {
+                    "observation/image": to_hwc_uint8(item["image"]),
+                    "observation/wrist_image": to_hwc_uint8(item["wrist_image"]),
+                    "observation/state": np.asarray(item["state"], np.float32),
+                    "prompt": item["prompt"],
+                }
+            )["actions"],
+            np.float64,
+        )
+        target = np.asarray(item["actions"], np.float64)
+        errors.append(predicted - target)
+        gripper_hits += int(np.sign(predicted[0, GRIPPER_DIM]) == np.sign(target[0, GRIPPER_DIM]))
+        if count % 128 == 0:
+            print(f"  {count}/{len(indices)}", flush=True)
+
+    error = np.stack(errors)
+
+    action_std = np.asarray([np.asarray(dataset[int(i)]["actions"], np.float64) for i in indices]).reshape(-1, 7).std(0)
+
+    rmse = np.sqrt((error**2).mean(axis=(0, 1)))
+    print(f"\n=== {args.config_name} @ {args.checkpoint_dir} on {args.repo_id} ===")
+    print(f"overall MSE (all dims)        : {(error**2).mean():.6f}")
+    print(f"overall MSE (pose dims 0-5)   : {(error[..., :6] ** 2).mean():.6f}")
+    print(f"gripper sign accuracy (t=0)   : {100.0 * gripper_hits / len(indices):.1f}%")
+    print("\nper-dim RMSE / demo std (normalized error; 1.0 == predicting the mean):")
+    names = ["dx", "dy", "dz", "drx", "dry", "drz", "grip"]
+    for dim, name in enumerate(names):
+        ratio = rmse[dim] / (action_std[dim] + 1e-12)
+        print(f"  {name:5s} rmse={rmse[dim]:.6f}  std={action_std[dim]:.6f}  ratio={ratio:.3f}")
+
+    first = np.sqrt((error[:, 0, :6] ** 2).mean())
+    last = np.sqrt((error[:, -1, :6] ** 2).mean())
+    print(f"\npose RMSE at chunk step 0: {first:.6f}   at step {horizon - 1}: {last:.6f}")
+
+
+if __name__ == "__main__":
+    main(tyro.cli(Args))
