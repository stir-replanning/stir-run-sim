+++ b/examples/kinova/serve_policy_inject.py
@@ -0,0 +1,540 @@
+import argparse
+import logging
+import os
+import socket
+import time
+
+_pre = argparse.ArgumentParser(add_help=False)
+_pre.add_argument("--gpu", default=None)
+try:
+    _gpu, _ = _pre.parse_known_args()
+    if _gpu.gpu is not None:
+        os.environ["CUDA_VISIBLE_DEVICES"] = str(_gpu.gpu)
+except SystemExit:
+    pass
+
+import einops
+import flax.nnx as nnx
+import flax.nnx.bridge.variables as bv
+import jax
+import jax.numpy as jnp
+import numpy as np
+from openpi_client import base_policy as _base_policy
+
+from openpi.models import gemma as _gemma
+from openpi.models import model as _model
+from openpi.models.pi0 import make_attn_mask
+from openpi.policies import policy_config as _policy_config
+from openpi.serving import websocket_policy_server
+from openpi.training import config as _config
+
+logger = logging.getLogger("openpi")
+
+INJECT_KEYS = ("prompt_contrast", "inject_site", "inject_scale", "inject_scale_c", "gate_thresh")
+_C_DIMS = (0, 1, 2, 6)
+
+
+def _cos_dist_img(a: jax.Array, b: jax.Array) -> jax.Array:
+    a = a.astype(jnp.float32)
+    b = b.astype(jnp.float32)
+    na = jnp.linalg.norm(a, axis=-1) + 1e-9
+    nb = jnp.linalg.norm(b, axis=-1) + 1e-9
+    cos = jnp.sum(a * b, axis=-1) / (na * nb)
+    return jnp.mean(1.0 - cos)
+
+
+def _prefix_forward(model, obs):
+    tokens, mask, ar = model.embed_prefix(obs)
+    attn_mask = make_attn_mask(mask, ar)
+    positions = jnp.cumsum(mask, axis=1) - 1
+    (prefix_out, _), kv_cache = model.PaliGemma.llm([tokens, None], mask=attn_mask, positions=positions)
+    return prefix_out, kv_cache, mask, tokens.shape[1]
+
+
+def _velocity(model, obs, kv_cache, prefix_mask, x_t, t, batch_size):
+    suffix_tokens, suffix_mask, suffix_ar_mask, adarms_cond = model.embed_suffix(
+        obs, x_t, jnp.broadcast_to(t, batch_size)
+    )
+    suffix_attn_mask = make_attn_mask(suffix_mask, suffix_ar_mask)
+    prefix_attn_mask = einops.repeat(prefix_mask, "b p -> b s p", s=suffix_tokens.shape[1])
+    full_attn_mask = jnp.concatenate([prefix_attn_mask, suffix_attn_mask], axis=-1)
+    positions = jnp.sum(prefix_mask, axis=-1)[:, None] + jnp.cumsum(suffix_mask, axis=-1) - 1
+    (_, suffix_out), _ = model.PaliGemma.llm(
+        [None, suffix_tokens],
+        mask=full_attn_mask,
+        positions=positions,
+        kv_cache=kv_cache,
+        adarms_cond=[None, adarms_cond],
+    )
+    return model.action_out_proj(suffix_out[:, -model.action_horizon :])
+
+
+def _sample_actions_injected(
+    model,
+    rng,
+    obs_new,
+    obs_old,
+    *,
+    inject_site: str,
+    inject_scale,
+    inject_scale_c,
+    gate_thresh,
+    gate_active: bool,
+    num_steps: int,
+    noise,
+):
+    obs_new = _model.preprocess_observation(None, obs_new, train=False)
+    obs_old = _model.preprocess_observation(None, obs_old, train=False)
+    rng, rng_rand = jax.random.split(rng)
+    dt = -1.0 / num_steps
+    batch_size = obs_new.state.shape[0]
+    if noise is None:
+        noise = jax.random.normal(rng, (batch_size, model.action_horizon, model.action_dim))
+
+    prefix_out_new, kv_new, mask_new, prefix_len = _prefix_forward(model, obs_new)
+    prefix_out_old, kv_old, mask_old, _ = _prefix_forward(model, obs_old)
+
+    n_lang = obs_new.tokenized_prompt.shape[1]
+    n_img = prefix_len - n_lang
+
+    d_img = _cos_dist_img(prefix_out_new[:, :n_img], prefix_out_old[:, :n_img])
+    gate = jnp.where(d_img < gate_thresh, 1.0, 0.0) if gate_active else jnp.float32(1.0)
+    s_eff = jnp.asarray(inject_scale, jnp.float32) * gate
+    w_eff = jnp.asarray(inject_scale_c, jnp.float32) * gate
+
+    use_A = inject_site in ("A", "AC")
+    use_C = inject_site in ("C", "AC")
+    use_Arand = inject_site == "Arand"
+
+    k_new, v_new = kv_new
+    if use_A:
+        _, v_old = kv_old
+        diff_v = v_new[..., :n_img, :, :] - v_old[..., :n_img, :, :]
+        v_inj = v_new.at[..., :n_img, :, :].add((s_eff * diff_v).astype(v_new.dtype))
+        kv_a = (k_new, v_inj)
+    elif use_Arand:
+        _, v_old = kv_old
+        diff_v = v_new[..., :n_img, :, :] - v_old[..., :n_img, :, :]
+        target = s_eff * jnp.linalg.norm(diff_v.astype(jnp.float32))
+        r = jax.random.normal(rng_rand, diff_v.shape, dtype=jnp.float32)
+        r = r * (target / (jnp.linalg.norm(r) + 1e-9))
+        v_inj = v_new.at[..., :n_img, :, :].add(r.astype(v_new.dtype))
+        kv_a = (k_new, v_inj)
+    else:
+        kv_a = kv_new
+
+    c_dims = jnp.asarray(_C_DIMS)
+
+    x_t = noise
+    t = 1.0
+    for _ in range(num_steps):
+        v_new_t = _velocity(model, obs_new, kv_a, mask_new, x_t, t, batch_size)
+        if use_C:
+            v_old_t = _velocity(model, obs_old, kv_old, mask_old, x_t, t, batch_size)
+            delta = (v_new_t - v_old_t)[:, :, c_dims]
+            v = v_new_t.at[:, :, c_dims].add((w_eff * delta).astype(v_new_t.dtype))
+        else:
+            v = v_new_t
+        x_t = x_t + dt * v
+        t = t + dt
+    return x_t
+
+
+def sample_actions_injected(
+    model,
+    rng,
+    obs_new,
+    obs_old,
+    *,
+    inject_site: str = "none",
+    inject_scale: float = 0.0,
+    inject_scale_c: float = 0.0,
+    gate_thresh: float | None = None,
+    num_steps: int = 10,
+    noise=None,
+):
+    gate_active = gate_thresh is not None
+    return _sample_actions_injected(
+        model,
+        rng,
+        obs_new,
+        obs_old,
+        inject_site=inject_site,
+        inject_scale=inject_scale,
+        inject_scale_c=inject_scale_c,
+        gate_thresh=jnp.float32(gate_thresh if gate_active else 0.0),
+        gate_active=gate_active,
+        num_steps=num_steps,
+        noise=noise,
+    )
+
+
+def _sample_actions_R(
+    model,
+    block,
+    rms,
+    unit_dirs,
+    *,
+    embed_dtype: str,
+    layers: tuple[int, ...],
+    depth: int,
+    rng,
+    obs_new,
+    obs_old,
+    alpha,
+    gate_thresh,
+    gate_active: bool,
+    num_steps: int,
+    noise,
+):
+    obs_new = _model.preprocess_observation(None, obs_new, train=False)
+    batch_size = obs_new.state.shape[0]
+    AH = model.action_horizon
+    AD = model.action_dim
+    if noise is None:
+        noise = jax.random.normal(rng, (batch_size, AH, AD))
+
+    llm = model.PaliGemma.llm
+    params = bv.nnx_attrs_to_linen_vars({n: getattr(llm, n) for n in llm.linen_attributes})["params"]
+
+    prefix_tokens, prefix_mask, prefix_ar_mask = model.embed_prefix(obs_new)
+    prefix_attn = make_attn_mask(prefix_mask, prefix_ar_mask)
+    prefix_pos = jnp.cumsum(prefix_mask, axis=1) - 1
+    (prefix_out_new, _), kv_cache = llm([prefix_tokens, None], mask=prefix_attn, positions=prefix_pos)
+    K, V = kv_cache
+
+    if gate_active:
+        obs_old = _model.preprocess_observation(None, obs_old, train=False)
+        pt_o, pm_o, par_o = model.embed_prefix(obs_old)
+        (prefix_out_old, _), _ = llm([pt_o, None], mask=make_attn_mask(pm_o, par_o),
+                                     positions=jnp.cumsum(pm_o, axis=1) - 1)
+        n_lang = obs_new.tokenized_prompt.shape[1]
+        n_img = prefix_tokens.shape[1] - n_lang
+        d_img = _cos_dist_img(prefix_out_new[:, :n_img], prefix_out_old[:, :n_img])
+        gate = jnp.where(d_img < gate_thresh, 1.0, 0.0)
+    else:
+        gate = jnp.float32(1.0)
+    alpha_eff = jnp.asarray(alpha, jnp.float32) * gate
+
+    layers_set = set(int(l) for l in layers)
+    dt = -1.0 / num_steps
+    x_t = noise
+    t = 1.0
+    for _ in range(num_steps):
+        suffix_tokens, suffix_mask, suffix_ar_mask, adarms_cond = model.embed_suffix(
+            obs_new, x_t, jnp.broadcast_to(t, batch_size)
+        )
+        suffix_attn = make_attn_mask(suffix_mask, suffix_ar_mask)
+        prefix_attn2 = einops.repeat(prefix_mask, "b p -> b s p", s=suffix_tokens.shape[1])
+        full_attn = jnp.concatenate([prefix_attn2, suffix_attn], axis=-1)
+        positions = jnp.sum(prefix_mask, axis=-1)[:, None] + jnp.cumsum(suffix_mask, axis=-1) - 1
+        mask4d = full_attn[:, None, :, :]
+        adarms = [None, adarms_cond]
+
+        xs = [None, suffix_tokens.astype(embed_dtype)]
+        for l in range(depth):
+            lp = jax.tree.map(lambda x: x[l], params["layers"])
+            xs, _ = block.apply({"params": lp}, xs, (K[l], V[l]), positions, mask4d, adarms, deterministic=True)
+            if l in layers_set:
+                res = xs[1].astype(jnp.float32)
+                scale_ref = jnp.sqrt(jnp.mean(jnp.square(res), axis=(1, 2)))
+                add = (alpha_eff * scale_ref)[:, None, None] * unit_dirs[l][None, None, :]
+                xs = [None, (res + add).astype(embed_dtype)]
+
+        normed, _ = rms.apply({"params": params["final_norm_1"]}, xs[1], adarms_cond)
+        v_t = model.action_out_proj(normed[:, -AH:])
+        x_t = x_t + dt * v_t
+        t = t + dt
+    return x_t
+
+
+class _RInjectSampler:
+    def __init__(self, model, pali_cfg, ae_cfg, embed_dtype: str, num_steps: int = 10):
+        self._graphdef, self._state = nnx.split(model)
+        self._block = _gemma.Block(configs=(pali_cfg, ae_cfg))
+        self._rms = _gemma.RMSNorm()
+        self._embed_dtype = embed_dtype
+        self._depth = ae_cfg.depth
+        self._num_steps = num_steps
+        self._cache: dict = {}
+
+    def _fn(self, layers: tuple[int, ...], gate_active: bool):
+        key = (layers, gate_active)
+        if key not in self._cache:
+
+            def fun(state, dirs, rng, obs_new, obs_old, alpha, gate_thresh, noise):
+                model = nnx.merge(self._graphdef, state)
+                return _sample_actions_R(
+                    model,
+                    self._block,
+                    self._rms,
+                    dirs,
+                    embed_dtype=self._embed_dtype,
+                    layers=layers,
+                    depth=self._depth,
+                    rng=rng,
+                    obs_new=obs_new,
+                    obs_old=obs_old,
+                    alpha=alpha,
+                    gate_thresh=gate_thresh,
+                    gate_active=gate_active,
+                    num_steps=self._num_steps,
+                    noise=noise,
+                )
+
+            self._cache[key] = jax.jit(fun)
+        return self._cache[key]
+
+    def __call__(self, rng, obs_new, obs_old, *, dirs, layers, alpha, gate_thresh, noise=None):
+        gate_active = gate_thresh is not None
+        fn = self._fn(tuple(layers), gate_active)
+        return fn(
+            self._state,
+            dirs,
+            rng,
+            obs_new,
+            obs_old,
+            jnp.float32(alpha),
+            jnp.float32(gate_thresh if gate_active else 0.0),
+            noise,
+        )
+
+
+def injection_debug(model, obs_new, obs_old) -> dict:
+    obs_new = _model.preprocess_observation(None, obs_new, train=False)
+    obs_old = _model.preprocess_observation(None, obs_old, train=False)
+    prefix_out_new, kv_new, _, prefix_len = _prefix_forward(model, obs_new)
+    prefix_out_old, kv_old, _, _ = _prefix_forward(model, obs_old)
+    n_lang = int(obs_new.tokenized_prompt.shape[1])
+    n_img = int(prefix_len) - n_lang
+    d_img = float(_cos_dist_img(prefix_out_new[:, :n_img], prefix_out_old[:, :n_img]))
+    k_new, v_new = kv_new
+    _, v_old = kv_old
+    v_diff_norm = float(jnp.linalg.norm((v_new[..., :n_img, :, :] - v_old[..., :n_img, :, :]).astype(jnp.float32)))
+    return {
+        "d_img": d_img,
+        "v_diff_img_norm": v_diff_norm,
+        "prefix_len": int(prefix_len),
+        "n_img": n_img,
+        "n_lang": n_lang,
+        "K_shape": tuple(int(x) for x in k_new.shape),
+        "V_shape": tuple(int(x) for x in v_new.shape),
+    }
+
+
+class _InjectSampler:
+    def __init__(self, model, num_steps: int = 10):
+        self._graphdef, self._state = nnx.split(model)
+        self._num_steps = num_steps
+        self._cache: dict = {}
+
+    def _fn(self, inject_site: str, gate_active: bool):
+        key = (inject_site, gate_active)
+        if key not in self._cache:
+
+            def fun(state, rng, obs_new, obs_old, inject_scale, inject_scale_c, gate_thresh, noise):
+                model = nnx.merge(self._graphdef, state)
+                return _sample_actions_injected(
+                    model,
+                    rng,
+                    obs_new,
+                    obs_old,
+                    inject_site=inject_site,
+                    inject_scale=inject_scale,
+                    inject_scale_c=inject_scale_c,
+                    gate_thresh=gate_thresh,
+                    gate_active=gate_active,
+                    num_steps=self._num_steps,
+                    noise=noise,
+                )
+
+            self._cache[key] = jax.jit(fun)
+        return self._cache[key]
+
+    def __call__(self, rng, obs_new, obs_old, *, inject_site, inject_scale, inject_scale_c, gate_thresh, noise=None):
+        gate_active = gate_thresh is not None
+        fn = self._fn(inject_site, gate_active)
+        return fn(
+            self._state,
+            rng,
+            obs_new,
+            obs_old,
+            jnp.float32(inject_scale),
+            jnp.float32(inject_scale_c),
+            jnp.float32(gate_thresh if gate_active else 0.0),
+            noise,
+        )
+
+
+class InjectPolicy(_base_policy.BasePolicy):
+    def __init__(self, policy, num_steps: int = 10, *, unit_dirs=None, rand_dirs=None,
+                 pali_cfg=None, ae_cfg=None, embed_dtype: str = "bfloat16", r_layers=(5,)):
+        self._policy = policy
+        self._model = policy._model
+        self._sampler = _InjectSampler(self._model, num_steps)
+        self._r_layers = tuple(int(l) for l in r_layers)
+        self._r_sampler = None
+        self._unit_dirs = None
+        self._rand_dirs = None
+        if unit_dirs is not None:
+            self._unit_dirs = jnp.asarray(unit_dirs, jnp.float32)
+            self._rand_dirs = jnp.asarray(rand_dirs, jnp.float32)
+            self._r_sampler = _RInjectSampler(self._model, pali_cfg, ae_cfg, embed_dtype, num_steps)
+            logger.info("site-R/Rrand enabled: %d dirs, target layers=%s", len(unit_dirs), self._r_layers)
+            self._warmup_R()
+
+    def _warmup_R(self) -> None:
+        try:
+            dummy = {
+                "observation/image": np.zeros((128, 128, 3), np.uint8),
+                "observation/wrist_image": np.zeros((128, 128, 3), np.uint8),
+                "observation/state": np.zeros((8,), np.float32),
+            }
+            d_new = self._policy._input_transform({**dummy, "prompt": "pick up the red cube"})
+            d_old = self._policy._input_transform({**dummy, "prompt": "pick up the yellow cube"})
+            obs_new = _model.Observation.from_dict(jax.tree.map(lambda x: jnp.asarray(x)[np.newaxis, ...], d_new))
+            obs_old = _model.Observation.from_dict(jax.tree.map(lambda x: jnp.asarray(x)[np.newaxis, ...], d_old))
+            rng = jax.random.key(0)
+            for gate in (None, 0.05):
+                t0 = time.monotonic()
+                out = self._r_sampler(rng, obs_new, obs_old, dirs=self._unit_dirs,
+                                      layers=self._r_layers, alpha=1.0, gate_thresh=gate, noise=None)
+                jax.block_until_ready(out)
+                logger.info("site-R warmup (gate=%s) compiled in %.1fs", gate, time.monotonic() - t0)
+        except Exception:
+            logger.exception("site-R warmup failed (will compile lazily on first call)")
+
+    @property
+    def metadata(self) -> dict:
+        return self._policy.metadata
+
+    def infer(self, obs: dict) -> dict:
+        inject_site = obs.get("inject_site", "none")
+        inject_scale = float(obs.get("inject_scale", 0.0) or 0.0)
+        inject_scale_c = float(obs.get("inject_scale_c", 0.0) or 0.0)
+        gate_thresh = obs.get("gate_thresh", None)
+        prompt = obs.get("prompt", None)
+        prompt_contrast = obs.get("prompt_contrast", None)
+
+        a_on = inject_site in ("A", "AC", "Arand") and inject_scale != 0.0
+        c_on = inject_site in ("C", "AC") and inject_scale_c != 0.0
+        is_r = inject_site in ("R", "Rrand")
+        r_on = is_r and inject_scale != 0.0 and self._r_sampler is not None
+        contrast_ok = prompt_contrast is not None and str(prompt_contrast) != str(prompt)
+        if is_r:
+            active = r_on and (gate_thresh is None or contrast_ok)
+        else:
+            active = inject_site not in (None, "none") and contrast_ok and (a_on or c_on)
+
+        if not active:
+            clean = {k: v for k, v in obs.items() if k not in INJECT_KEYS}
+            return self._policy.infer(clean)
+
+        base = {k: v for k, v in obs.items() if k not in INJECT_KEYS}
+        d_new = {**base, "prompt": prompt}
+        d_old = {**base, "prompt": prompt_contrast}
+        inputs_new = self._policy._input_transform(jax.tree.map(lambda x: x, d_new))
+        inputs_old = self._policy._input_transform(jax.tree.map(lambda x: x, d_old))
+        inputs_new = jax.tree.map(lambda x: jnp.asarray(x)[np.newaxis, ...], inputs_new)
+        inputs_old = jax.tree.map(lambda x: jnp.asarray(x)[np.newaxis, ...], inputs_old)
+        obs_new = _model.Observation.from_dict(inputs_new)
+        obs_old = _model.Observation.from_dict(inputs_old)
+
+        self._policy._rng, rng = jax.random.split(self._policy._rng)
+        gate_val = None if gate_thresh is None else float(gate_thresh)
+
+        start = time.monotonic()
+        if inject_site in ("R", "Rrand"):
+            dirs = self._rand_dirs if inject_site == "Rrand" else self._unit_dirs
+            actions = self._r_sampler(
+                rng,
+                obs_new,
+                obs_old,
+                dirs=dirs,
+                layers=self._r_layers,
+                alpha=inject_scale,
+                gate_thresh=gate_val,
+                noise=None,
+            )
+        else:
+            actions = self._sampler(
+                rng,
+                obs_new,
+                obs_old,
+                inject_site=inject_site,
+                inject_scale=inject_scale,
+                inject_scale_c=inject_scale_c,
+                gate_thresh=gate_val,
+                noise=None,
+            )
+        model_time = time.monotonic() - start
+
+        outputs = {"state": inputs_new["state"], "actions": actions}
+        outputs = jax.tree.map(lambda x: np.asarray(x[0, ...]), outputs)
+        outputs = self._policy._output_transform(outputs)
+        outputs["policy_timing"] = {"infer_ms": model_time * 1000}
+        return outputs
+
+
+def build_policy(config_name: str, checkpoint_dir: str, num_steps: int = 10,
+                 probe_npz: str | None = None, inject_layers=(5,), rand_seed: int = 0) -> InjectPolicy:
+    train_cfg = _config.get_config(config_name)
+    policy = _policy_config.create_trained_policy(train_cfg, checkpoint_dir)
+
+    unit_dirs = rand_dirs = pali_cfg = ae_cfg = None
+    embed_dtype = str(train_cfg.model.dtype)
+    if probe_npz is not None:
+        z = np.load(probe_npz, allow_pickle=True)
+        dirs = np.asarray(z["dirs"], np.float32)
+        unit_dirs = dirs / (np.linalg.norm(dirs, axis=1, keepdims=True) + 1e-9)
+        rng = np.random.default_rng(rand_seed)
+        rd = rng.standard_normal(dirs.shape).astype(np.float32)
+        rand_dirs = rd / (np.linalg.norm(rd, axis=1, keepdims=True) + 1e-9)
+        pali_cfg = _gemma.get_config(train_cfg.model.paligemma_variant)
+        ae_cfg = _gemma.get_config(train_cfg.model.action_expert_variant)
+        logger.info("loaded probe dirs %s from %s; L2-normalised. Rrand seed=%d", dirs.shape, probe_npz, rand_seed)
+
+    return InjectPolicy(
+        policy, num_steps=num_steps, unit_dirs=unit_dirs, rand_dirs=rand_dirs, pali_cfg=pali_cfg,
+        ae_cfg=ae_cfg, embed_dtype=embed_dtype, r_layers=inject_layers,
+    )
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser(description="pi05_kinova_sim policy server with inference-time activation injection")
+    ap.add_argument("--config", default="pi05_kinova_sim")
+    ap.add_argument(
+        "--checkpoint",
+        default="checkpoints/pi05_kinova_sim/pi05_kinova_sim/29999",
+        help="checkpoint step directory",
+    )
+    ap.add_argument("--port", type=int, default=8010)
+    ap.add_argument("--gpu", default=None, help="pins CUDA_VISIBLE_DEVICES (applied before jax import)")
+    ap.add_argument("--num-steps", type=int, default=10, help="flow-matching denoise steps")
+    ap.add_argument("--probe-npz", default=None, help="probe_dirs.npz for site-R residual steering")
+    ap.add_argument("--inject-layer", default="5",
+                    help="site-R target gemma layer(s), comma-separated (default 5)")
+    ap.add_argument("--rand-seed", type=int, default=0,
+                    help="seed for the site-Rrand random control direction")
+    args = ap.parse_args()
+
+    inject_layers = tuple(int(x) for x in str(args.inject_layer).split(",") if x != "")
+    logging.basicConfig(level=logging.INFO, force=True)
+    policy = build_policy(args.config, args.checkpoint, num_steps=args.num_steps,
+                          probe_npz=args.probe_npz, inject_layers=inject_layers, rand_seed=args.rand_seed)
+
+    hostname = socket.gethostname()
+    local_ip = socket.gethostbyname(hostname)
+    logging.info("Creating injection server (host: %s, ip: %s, port: %d)", hostname, local_ip, args.port)
+
+    server = websocket_policy_server.WebsocketPolicyServer(
+        policy=policy,
+        host="0.0.0.0",
+        port=args.port,
+        metadata=policy.metadata,
+    )
+    server.serve_forever()
+
+
+if __name__ == "__main__":
+    main()
