+    def _counterfactual_prompt(self, tokenized_prompt: at.Int[at.Array, "b l"]) -> at.Int[at.Array, "b l"]:
+        return jnp.where(
+            tokenized_prompt == self.dimg_cf_token_a,
+            self.dimg_cf_token_b,
+            jnp.where(tokenized_prompt == self.dimg_cf_token_b, self.dimg_cf_token_a, tokenized_prompt),
+        )
+
+    def _compute_d_img(
+        self,
+        observation: _model.Observation,
+        prefix_tokens: at.Float[at.Array, "b s emb"],
+        prefix_out: at.Float[at.Array, "b s emb"],
+        prefix_mask: at.Bool[at.Array, "b s"],
+        prefix_ar_mask: at.Bool[at.Array, " s"],
+    ) -> at.Float[at.Array, " b"]:
+        cf_prompt = self._counterfactual_prompt(observation.tokenized_prompt)
+        n_img = prefix_tokens.shape[1] - observation.tokenized_prompt.shape[1]
+        cf_lang = self.PaliGemma.llm(cf_prompt, method="embed")
+        cf_tokens = jnp.concatenate([prefix_tokens[:, :n_img], cf_lang], axis=1)
+        cf_attn_mask = make_attn_mask(prefix_mask, prefix_ar_mask)
+        cf_positions = jnp.cumsum(prefix_mask, axis=1) - 1
+        (cf_prefix_out, _), _ = self.PaliGemma.llm([cf_tokens, None], mask=cf_attn_mask, positions=cf_positions)
+
+        real_img = prefix_out[:, :n_img].astype(jnp.float32)
+        cf_img = cf_prefix_out[:, :n_img].astype(jnp.float32)
+        num = jnp.sum(real_img * cf_img, axis=-1)
+        den = jnp.linalg.norm(real_img, axis=-1) * jnp.linalg.norm(cf_img, axis=-1) + 1e-9
+        return jnp.mean(1.0 - num / den, axis=-1)
+
+    def _calibrated_target(self, target: at.Float[at.Array, " b"]) -> at.Float[at.Array, " b"]:
+        z = (target - self.dimg_d_mean) / self.dimg_d_std
+        return jnp.clip(z * self.dimg_target_sig + self.dimg_target_mu, 0.0, self.dimg_tilde_clip)
+
+    def _dimg_aux_term(self, d_img: at.Float[at.Array, " b"], observation: _model.Observation) -> at.Float[at.Array, ""]:
+        if self.dimg_aux_mode == "margin":
+            return jnp.mean(jax.nn.relu(self.dimg_margin - d_img))
+
+        target = observation.dimg_target.astype(jnp.float32)
+        w = observation.dimg_target_mask.astype(jnp.float32)
+        n = jnp.sum(w)
+        safe_n = jnp.maximum(n, 1.0)
+
+        if self.dimg_aux_mode == "grounded_abs":
+            d_tilde = self._calibrated_target(target)
+            mse = jnp.sum(w * (d_img - d_tilde) ** 2) / safe_n
+            return jnp.where(n >= 1.0, mse, 0.0)
+
+        def zscore(x):
+            mean = jnp.sum(w * x) / safe_n
+            var = jnp.sum(w * (x - mean) ** 2) / safe_n
+            return (x - mean) / jnp.sqrt(var + 1e-6)
+
+        tie = jnp.sum(w * (zscore(d_img) - zscore(target)) ** 2) / safe_n
+        return jnp.where(n >= 2.0, tie, 0.0)
+
+    def dimg_metrics(self, rng: at.KeyArrayLike, observation: _model.Observation) -> dict[str, at.Array]:
+        observation = _model.preprocess_observation(None, observation, train=False)
+        prefix_tokens, prefix_mask, prefix_ar_mask = self.embed_prefix(observation)
+        attn_mask = make_attn_mask(prefix_mask, prefix_ar_mask)
+        positions = jnp.cumsum(prefix_mask, axis=1) - 1
+        (prefix_out, _), _ = self.PaliGemma.llm([prefix_tokens, None], mask=attn_mask, positions=positions)
+        d_img = self._compute_d_img(observation, prefix_tokens, prefix_out, prefix_mask, prefix_ar_mask)
+        tie = self._dimg_aux_term(d_img, observation)
+        return {"d_img": d_img, "aux": self.dimg_aux_weight * tie, "tie": tie}
 
