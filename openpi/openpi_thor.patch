diff --git a/examples/kinova/build_dimg_targets.py b/examples/kinova/build_dimg_targets.py
new file mode 100644
index 0000000..f599919
--- /dev/null
+++ b/examples/kinova/build_dimg_targets.py
@@ -0,0 +1,120 @@
+import argparse
+import glob
+import pathlib
+
+import numpy as np
+import pandas as pd
+from scipy.spatial import cKDTree
+
+XYZG = [0, 1, 2, 6]
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--repo-id", default="kinova/sim")
+    ap.add_argument("--lerobot-root", default=str(pathlib.Path.home() / ".cache/huggingface/lerobot"))
+    ap.add_argument("--action-horizon", type=int, default=10)
+    ap.add_argument("--radius", type=float, default=0.05, help="EE-xyz radius (m) defining coverage/mask")
+    ap.add_argument("--out", default=None, help="output .npz (default assets/dimg_targets/<repo>.npz)")
+    args = ap.parse_args()
+
+    ah = args.action_horizon
+    data_dir = pathlib.Path(args.lerobot_root) / args.repo_id / "data"
+    files = sorted(glob.glob(str(data_dir / "chunk-*" / "episode_*.parquet")))
+    if not files:
+        raise FileNotFoundError(f"no parquet under {data_dir}")
+    print(f"{len(files)} episode parquets under {data_dir}")
+
+    cols = ["state", "actions", "frame_index", "episode_index", "index", "task_index"]
+    parts = [pd.read_parquet(f, columns=cols) for f in files]
+    df = pd.concat(parts, ignore_index=True).sort_values("index").reset_index(drop=True)
+    n = len(df)
+
+    gidx = df["index"].to_numpy(np.int64)
+    epi = df["episode_index"].to_numpy(np.int64)
+    frame_idx = df["frame_index"].to_numpy(np.int64)
+    goal = df["task_index"].to_numpy(np.int64)
+    state = np.stack(df["state"].to_numpy()).astype(np.float32)
+    act = np.stack(df["actions"].to_numpy()).astype(np.float32)
+    ee_xyz = state[:, :3].copy()
+    print(f"{n} frames, goals: red(0)={int((goal == 0).sum())} yellow(1)={int((goal == 1).sum())}")
+
+    net_disp = np.zeros((n, len(XYZG)), np.float32)
+    pad = np.zeros(n, bool)
+    for _, sub in df.groupby("episode_index"):
+        rows = sub.index.to_numpy()
+        a = act[rows]
+        T = len(rows)
+        for i in range(T):
+            if i + ah <= T:
+                net_disp[rows[i]] = a[i : i + ah][:, XYZG].sum(0)
+            else:
+                pad[rows[i]] = True
+
+    valid_base = ~pad
+
+    D = np.full(n, np.nan, np.float32)
+    nn_dist = np.full(n, np.inf, np.float32)
+    nn_gidx = np.full(n, -1, np.int64)
+
+    cand = {}
+    for g in (0, 1):
+        pos = np.where((goal == g) & valid_base)[0]
+        cand[g] = (cKDTree(ee_xyz[pos]), pos)
+
+    for g in (0, 1):
+        other = 1 - g
+        tree, other_pos = cand[other]
+        q = np.where((goal == g) & valid_base)[0]
+        dist, j = tree.query(ee_xyz[q], k=1)
+        nn = other_pos[j]
+        nn_dist[q] = dist.astype(np.float32)
+        nn_gidx[q] = gidx[nn]
+        D[q] = np.linalg.norm(net_disp[q] - net_disp[nn], axis=1).astype(np.float32)
+
+    mask = valid_base & (nn_dist <= args.radius)
+
+    out = pathlib.Path(args.out) if args.out else (
+        pathlib.Path(__file__).resolve().parents[2] / "assets" / "dimg_targets" / f"{args.repo_id}.npz"
+    )
+    out.parent.mkdir(parents=True, exist_ok=True)
+    np.savez(
+        out,
+        index=gidx, episode_index=epi, frame_index=frame_idx, task_index=goal,
+        ee_xyz=ee_xyz, net_disp=net_disp,
+        D=D, nn_dist=nn_dist, nn_index=nn_gidx, valid_base=valid_base,
+        action_horizon=np.int64(ah), radius=np.float32(args.radius), repo_id=args.repo_id,
+    )
+    print(f"wrote {out}")
+
+    print("\n== coverage by EE-xyz radius (fraction of non-pad frames with a cross-goal neighbour) ==")
+    nb = int(valid_base.sum())
+    for r in (0.02, 0.03, 0.05, 0.08, 0.10, 0.15):
+        cov = float(((nn_dist <= r) & valid_base).sum()) / nb
+        print(f"  r={r:.2f} m : {cov * 100:5.1f}%  ({int(((nn_dist <= r) & valid_base).sum())}/{nb})")
+
+    tau = np.zeros(n, np.float32)
+    for _, sub in df.groupby("episode_index"):
+        rows = sub.index.to_numpy()
+        L = max(len(rows) - 1, 1)
+        tau[rows] = np.arange(len(rows)) / L
+    print(f"\n== coverage by execution depth tau (radius r={args.radius:.2f} m) ==")
+    edges = np.linspace(0, 1, 6)
+    for lo, hi in zip(edges[:-1], edges[1:]):
+        sel = valid_base & (tau >= lo) & (tau < hi + (1e-6 if hi == 1.0 else 0))
+        if sel.sum() == 0:
+            continue
+        cov = float((mask & sel).sum()) / float(sel.sum())
+        dsel = D[mask & sel]
+        dmean = float(np.mean(dsel)) if dsel.size else float("nan")
+        print(f"  tau[{lo:.1f},{hi:.1f}) : cov={cov * 100:5.1f}%  mean_D(covered)={dmean:.4f}  n={int(sel.sum())}")
+
+    dm = D[mask]
+    print(f"\n== D over covered frames (r={args.radius:.2f}) : n={dm.size} "
+          f"mean={np.mean(dm):.4f} std={np.std(dm):.4f} "
+          f"min={np.min(dm):.4f} p50={np.median(dm):.4f} max={np.max(dm):.4f} ==")
+    print(f"covered fraction of ALL frames: {100 * mask.sum() / n:.1f}%  ({int(mask.sum())}/{n})")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/examples/kinova/cmi_repr_probe.py b/examples/kinova/cmi_repr_probe.py
