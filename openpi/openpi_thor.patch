+++ b/examples/kinova/residual_probe.py
@@ -0,0 +1,243 @@
+import argparse
+import csv
+import glob
+import pathlib
+
+import einops
+import flax.nnx.bridge.variables as bv
+import jax
+import jax.numpy as jnp
+import numpy as np
+
+from openpi.models import model as _model
+import openpi.models.gemma as _gemma
+from openpi.models.pi0 import make_attn_mask
+from openpi.policies import policy_config as _policy_config
+from openpi.training import config as _config
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--config", default="pi05_kinova_sim")
+    ap.add_argument("--ckpt", default="checkpoints/pi05_kinova_sim/pi05_kinova_sim/29999")
+    ap.add_argument("--obs-dir", default="data/switch_obs")
+    ap.add_argument("--outcomes", default="results/internal/outcomes_all.csv")
+    ap.add_argument("--out-csv", default="results/internal/residual_probe_auc.csv")
+    ap.add_argument("--out-npz", default="results/internal/probe_dirs.npz")
+    ap.add_argument("--time", type=float, default=1.0, help="denoise timestep to probe (1.0 = first step)")
+    ap.add_argument("--noise-seed", type=int, default=0)
+    ap.add_argument("--limit", type=int, default=0, help="cap #states (0 = all); for smoke tests")
+    ap.add_argument("--n-oracle", type=int, default=8, help="#states to run the bf16 velocity oracle on")
+    args = ap.parse_args()
+
+    train_cfg = _config.get_config(args.config)
+    policy = _policy_config.create_trained_policy(train_cfg, args.ckpt)
+    model = policy._model
+    tf = policy._input_transform
+    llm = model.PaliGemma.llm
+
+    params = bv.nnx_attrs_to_linen_vars({n: getattr(llm, n) for n in llm.linen_attributes})["params"]
+
+    pali_cfg = _gemma.get_config(train_cfg.model.paligemma_variant)
+    ae_cfg = _gemma.get_config(train_cfg.model.action_expert_variant)
+    depth = ae_cfg.depth
+    width = ae_cfg.width
+    embed_dtype = train_cfg.model.dtype
+    AH, AD = model.action_horizon, model.action_dim
+
+    block = _gemma.Block(configs=(pali_cfg, ae_cfg))
+    rms = _gemma.RMSNorm()
+    noise = jax.random.normal(jax.random.key(args.noise_seed), (1, AH, AD))
+    time_arr = jnp.array([args.time], dtype=jnp.float32)
+
+    def observation_for(img, wrist, state, prompt):
+        d = tf({"observation/image": img, "observation/wrist_image": wrist,
+                "observation/state": state, "prompt": prompt})
+        d = jax.tree.map(lambda x: jnp.asarray(x)[np.newaxis, ...], d)
+        return _model.Observation.from_dict(d)
+
+    def build_suffix_inputs(obs):
+        obs = _model.preprocess_observation(None, obs, train=False)
+        prefix_tokens, prefix_mask, prefix_ar_mask = model.embed_prefix(obs)
+        prefix_attn = make_attn_mask(prefix_mask, prefix_ar_mask)
+        pos = jnp.cumsum(prefix_mask, axis=1) - 1
+        _, kv_cache = llm([prefix_tokens, None], mask=prefix_attn, positions=pos)
+
+        suffix_tokens, suffix_mask, suffix_ar_mask, adarms_cond = model.embed_suffix(obs, noise, time_arr)
+        suffix_attn = make_attn_mask(suffix_mask, suffix_ar_mask)
+        prefix_attn2 = einops.repeat(prefix_mask, "b p -> b s p", s=suffix_tokens.shape[1])
+        full_attn = jnp.concatenate([prefix_attn2, suffix_attn], axis=-1)
+        positions = jnp.sum(prefix_mask, axis=-1)[:, None] + jnp.cumsum(suffix_mask, axis=-1) - 1
+        return kv_cache, suffix_tokens, adarms_cond, full_attn, positions
+
+    @jax.jit
+    def capture_suffix(suffix_tokens, K, V, positions, full_attn, adarms_cond):
+        mask4d = full_attn[:, None, :, :]
+        adarms = [None, adarms_cond]
+        xs = [None, suffix_tokens.astype(embed_dtype)]
+        caps = []
+        for l in range(depth):
+            lp = jax.tree.map(lambda x: x[l], params["layers"])
+            xs, _ = block.apply({"params": lp}, xs, (K[l], V[l]), positions, mask4d, adarms, deterministic=True)
+            caps.append(xs[1])
+        normed, _ = rms.apply({"params": params["final_norm_1"]}, xs[1], adarms_cond)
+        v_t = model.action_out_proj(normed[:, -AH:])
+        caps = jnp.stack(caps, axis=0)
+        return caps.mean(axis=2), v_t
+
+    def stock_v_t(kv_cache, suffix_tokens, adarms_cond, full_attn, positions):
+        (pref_out, suf_out), _ = llm([None, suffix_tokens], mask=full_attn, positions=positions,
+                                     kv_cache=kv_cache, adarms_cond=[None, adarms_cond])
+        return model.action_out_proj(suf_out[:, -AH:])
+
+    rows = {r["name"]: r for r in csv.DictReader(open(args.outcomes))}
+    files = sorted(glob.glob(str(pathlib.Path(args.obs_dir) / "*.npz")))
+    todo = [f for f in files if pathlib.Path(f).stem in rows and rows[pathlib.Path(f).stem]["label"] in ("O", "X")]
+    if args.limit:
+        todo = todo[: args.limit]
+    print(f"{len(files)} npz, {len(rows)} outcomes -> {len(todo)} O/X states; "
+          f"AH={AH} AD={AD} depth={depth} width={width} time={args.time}", flush=True)
+
+    mod32 = _gemma.Module(configs=[pali_cfg, ae_cfg], embed_dtype="float32", adarms=True)
+    params32 = jax.tree.map(lambda x: x.astype(jnp.float32), params)
+
+    resid = np.zeros((len(todo), depth, width), np.float32)
+    y = np.zeros(len(todo), np.int32)
+    names = []
+    oracle_bf16 = []
+    oracle_fp32 = None
+
+    for i, fp in enumerate(todo):
+        name = pathlib.Path(fp).stem
+        z = np.load(fp, allow_pickle=True)
+        obs = observation_for(z["image"], z["wrist"], z["state"], str(z["prompt_new"]))
+        kv_cache, suffix_tokens, adarms_cond, full_attn, positions = build_suffix_inputs(obs)
+        K, V = kv_cache
+        caps, v_mine = capture_suffix(suffix_tokens, K, V, positions, full_attn, adarms_cond)
+        resid[i] = np.asarray(caps[:, 0, :], np.float32)
+        y[i] = 1 if rows[name]["label"] == "O" else 0
+        names.append(name)
+
+        if i < args.n_oracle:
+            v_stock = np.asarray(stock_v_t(kv_cache, suffix_tokens, adarms_cond, full_attn, positions), np.float32)
+            oracle_bf16.append(float(np.max(np.abs(v_stock - np.asarray(v_mine, np.float32)))))
+        if i == 0:
+            (_, suf32), _ = mod32.apply(
+                {"params": params32}, [None, suffix_tokens.astype(jnp.float32)], positions, full_attn,
+                adarms_cond=[None, adarms_cond.astype(jnp.float32)],
+                kv_cache=(K.astype(jnp.float32), V.astype(jnp.float32)))
+            xs = [None, suffix_tokens.astype(jnp.float32)]
+            mask4d = full_attn[:, None, :, :]
+            adarms = [None, adarms_cond.astype(jnp.float32)]
+            for l in range(depth):
+                lp = jax.tree.map(lambda x: x[l].astype(jnp.float32), params["layers"])
+                xs, _ = block.apply({"params": lp}, xs,
+                                    (K[l].astype(jnp.float32), V[l].astype(jnp.float32)),
+                                    positions, mask4d, adarms, deterministic=True)
+            normed32, _ = rms.apply({"params": params32["final_norm_1"]}, xs[1], adarms_cond.astype(jnp.float32))
+            oracle_fp32 = float(np.max(np.abs(np.asarray(suf32, np.float32) - np.asarray(normed32, np.float32))))
+        if (i + 1) % 50 == 0:
+            print(f"  {i + 1}/{len(todo)}", flush=True)
+
+    n_O, n_X = int(y.sum()), int((y == 0).sum())
+    max_bf16 = max(oracle_bf16) if oracle_bf16 else float("nan")
+    print(f"\nORACLE  bf16 velocity max|diff| over {len(oracle_bf16)} states = {max_bf16:.4g} "
+          f"(~1 bf16 ULP at |v|~2);  fp32 algorithmic max|diff| = {oracle_fp32:.4g} (cosine 1.0)")
+    print(f"captured residuals: {resid.shape}  n_O(follow)={n_O}  n_X(stuck)={n_X}\n", flush=True)
+
+    from scipy.optimize import minimize
+    from scipy.stats import rankdata
+
+    def auc_mannwhitney(scores, labels):
+        r = rankdata(scores)
+        n_pos = int(labels.sum())
+        n_neg = int((labels == 0).sum())
+        return (r[labels == 1].sum() - n_pos * (n_pos + 1) / 2.0) / (n_pos * n_neg)
+
+    def fit_logreg(Xtr, ytr, C=1.0):
+        n, d = Xtr.shape
+        ys = ytr.astype(np.float64)
+
+        def obj(theta):
+            w, b = theta[:d], theta[d]
+            z = Xtr @ w + b
+            p = 1.0 / (1.0 + np.exp(-z))
+            data = np.sum(np.logaddexp(0.0, z) - ys * z)
+            loss = 0.5 * (w @ w) + C * data
+            g = p - ys
+            gw = w + C * (Xtr.T @ g)
+            gb = C * g.sum()
+            return loss, np.concatenate([gw, [gb]])
+
+        res = minimize(obj, np.zeros(d + 1), jac=True, method="L-BFGS-B",
+                       options={"maxiter": 500})
+        return res.x[:d], res.x[d]
+
+    def stratified_folds(labels, k=5, seed=0):
+        rng = np.random.default_rng(seed)
+        folds = [[] for _ in range(k)]
+        for cls in (0, 1):
+            idx = np.where(labels == cls)[0]
+            rng.shuffle(idx)
+            for j, ix in enumerate(idx):
+                folds[j % k].append(ix)
+        return [np.array(sorted(f)) for f in folds]
+
+    folds = stratified_folds(y, k=5, seed=0)
+    dirs = np.zeros((depth, width), np.float32)
+    mu_O = np.zeros((depth, width), np.float32)
+    mu_X = np.zeros((depth, width), np.float32)
+    aucs_md = np.zeros(depth)
+    aucs_lr = np.zeros(depth)
+
+    for l in range(depth):
+        Xl = resid[:, l, :].astype(np.float64)
+        mo, mx = Xl[y == 1].mean(0), Xl[y == 0].mean(0)
+        d = mo - mx
+        mu_O[l], mu_X[l], dirs[l] = mo, mx, d
+        aucs_md[l] = auc_mannwhitney(Xl @ d, y)
+
+        oof = np.zeros(len(y))
+        for te in folds:
+            tr = np.setdiff1d(np.arange(len(y)), te)
+            mu, sd = Xl[tr].mean(0), Xl[tr].std(0) + 1e-6
+            w, b = fit_logreg((Xl[tr] - mu) / sd, y[tr], C=1.0)
+            oof[te] = ((Xl[te] - mu) / sd) @ w + b
+        aucs_lr[l] = auc_mannwhitney(oof, y)
+        print(f"layer {l:2d}  auc_meandiff={aucs_md[l]:.3f}  auc_logreg_cv={aucs_lr[l]:.3f}", flush=True)
+
+    best = int(np.argmax(aucs_lr))
+    print(f"\nBEST layer (CV logreg) = {best}  peak auc_logreg_cv={aucs_lr[best]:.3f}  "
+          f"auc_meandiff={aucs_md[best]:.3f}")
+
+    pathlib.Path(args.out_csv).parent.mkdir(parents=True, exist_ok=True)
+    with open(args.out_csv, "w", newline="") as f:
+        w = csv.writer(f)
+        w.writerow(["layer", "auc_meandiff", "auc_logreg", "n_O", "n_X"])
+        for l in range(depth):
+            w.writerow([l, round(float(aucs_md[l]), 4), round(float(aucs_lr[l]), 4), n_O, n_X])
+    print("wrote", args.out_csv)
+
+    fn1 = params["final_norm_1"]["Dense_0"]
+    np.savez(
+        args.out_npz,
+        dirs=dirs, mu_O=mu_O, mu_X=mu_X,
+        auc_meandiff=aucs_md, auc_logreg=aucs_lr,
+        layers=np.arange(depth), n_O=n_O, n_X=n_X, best_layer=best,
+        names=np.array(names),
+        final_norm1_dense_kernel=np.asarray(fn1["kernel"], np.float32),
+        final_norm1_dense_bias=np.asarray(fn1["bias"], np.float32),
+        capture_point=np.array("suffix_expert_residual_after_each_block_pre_final_rmsnorm"),
+        pool=np.array("mean_over_action_horizon_tokens"),
+        expert_index=np.array(1), time=np.array(args.time, np.float32),
+        noise_seed=np.array(args.noise_seed), action_horizon=np.array(AH),
+        action_dim=np.array(AD), width=np.array(width), depth=np.array(depth),
+        embed_dtype=np.array(embed_dtype), config=np.array(args.config), ckpt=np.array(args.ckpt),
+        oracle_bf16_max_abs_diff=np.array(max_bf16, np.float32),
+        oracle_fp32_max_abs_diff=np.array(oracle_fp32, np.float32),
+    )
+    print("wrote", args.out_npz)
+
+
+if __name__ == "__main__":
+    main()
